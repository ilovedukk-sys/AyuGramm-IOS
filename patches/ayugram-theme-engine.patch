diff --git a/submodules/Display/Source/AyuTheme.swift b/submodules/Display/Source/AyuTheme.swift
new file mode 100644
index 0000000..ab0b88d
--- /dev/null
+++ b/submodules/Display/Source/AyuTheme.swift
@@ -0,0 +1,538 @@
+import Foundation
+import CoreGraphics
+import CoreText
+
+public enum AyuThemeError: LocalizedError {
+    case invalidFile
+    case newerFormat
+    case unreadablePalette
+    case invalidFont
+
+    public var errorDescription: String? {
+        switch self {
+        case .invalidFile:
+            return "Invalid .ayutheme file."
+        case .newerFormat:
+            return "This theme needs a newer version of the app."
+        case .unreadablePalette:
+            return "The palette colors are too close to each other: text would be unreadable."
+        case .invalidFont:
+            return "A font in this theme is damaged or not supported."
+        }
+    }
+}
+
+/// A theme file: values for the pixel style and optional fonts, read once at launch. It holds no code.
+public struct AyuTheme: Codable, Equatable {
+    public static let formatName = "ayu-theme-1"
+    public static let fileExtension = "ayutheme"
+    /// Fonts are carried as base64 inside the file.
+    public static let maximumFileBytes = 8 * 1024 * 1024
+    public static let maximumFontBytes = 4 * 1024 * 1024
+    public static let maximumFontCount = 3
+    private static let builtInFonts: [String: String?] = [
+        "golos": "GolosText-Regular",
+        "handjet": "Handjet-Regular",
+        "plex": "IBMPlexMono-Regular",
+        "system": nil
+    ]
+
+    public struct Palette: Codable, Equatable {
+        public var dark: String = "#000000"
+        public var light: String = "#FFFFFF"
+
+        public init() {
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case dark, light
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            self.dark = try container.decodeIfPresent(String.self, forKey: .dark) ?? self.dark
+            self.light = try container.decodeIfPresent(String.self, forKey: .light) ?? self.light
+        }
+    }
+
+    public struct Shapes: Codable, Equatable {
+        public enum Corners: String, Codable {
+            case square, stock
+        }
+        public enum Panels: String, Codable {
+            case flat, stock
+        }
+        public enum TabBar: String, Codable {
+            case flat, stock
+        }
+
+        /// Layers, circles and message bubbles.
+        public var corners: Corners = .square
+        /// Flat panels are always square. `stock` keeps the glass with its motion.
+        public var panels: Panels = .flat
+        public var tabBar: TabBar = .flat
+
+        public init() {
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case corners, panels, tabBar
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            self.corners = try container.decodeIfPresent(Corners.self, forKey: .corners) ?? self.corners
+            self.panels = try container.decodeIfPresent(Panels.self, forKey: .panels) ?? self.panels
+            self.tabBar = try container.decodeIfPresent(TabBar.self, forKey: .tabBar) ?? self.tabBar
+        }
+    }
+
+    public struct Fonts: Codable, Equatable {
+        /// `golos`, `handjet`, `plex`, `system` or the id of one of the theme's own fonts.
+        public var body: String = "golos"
+        public var title: String = "handjet"
+        public var label: String = "plex"
+
+        public init() {
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case body, title, label
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            self.body = try container.decodeIfPresent(String.self, forKey: .body) ?? self.body
+            self.title = try container.decodeIfPresent(String.self, forKey: .title) ?? self.title
+            self.label = try container.decodeIfPresent(String.self, forKey: .label) ?? self.label
+        }
+    }
+
+    public struct CustomFont: Codable, Equatable {
+        public var id: String
+        /// The font file as base64 in a theme file. An installed theme keeps the font next to it instead.
+        public var file: String?
+        /// Read from the font when it is installed.
+        public var postScriptName: String?
+
+        public init(id: String, file: String?, postScriptName: String?) {
+            self.id = id
+            self.file = file
+            self.postScriptName = postScriptName
+        }
+    }
+
+    public struct Icons: Codable, Equatable {
+        /// The size of a pixel of an icon in points. 0 keeps the icons as they are.
+        public var grid: Int = 1
+
+        public init() {
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case grid
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            self.grid = try container.decodeIfPresent(Int.self, forKey: .grid) ?? self.grid
+        }
+    }
+
+    public struct Avatars: Codable, Equatable {
+        /// Cells on a side of the mosaic. 0 keeps the full resolution.
+        public var mosaic: Int = 24
+        public var gray: Bool = true
+
+        public init() {
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case mosaic, gray
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            self.mosaic = try container.decodeIfPresent(Int.self, forKey: .mosaic) ?? self.mosaic
+            self.gray = try container.decodeIfPresent(Bool.self, forKey: .gray) ?? self.gray
+        }
+    }
+
+    public struct Media: Codable, Equatable {
+        /// Stickers, custom emoji and animated icons take the palette's light color.
+        public var gray: Bool = true
+        /// The multiplier of their pixel size. 0 keeps the full resolution.
+        public var grid: Int = 1
+        /// Whether the sticker and emoji panels follow these values too.
+        public var pickers: Bool = true
+
+        public init() {
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case gray, grid, pickers
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            self.gray = try container.decodeIfPresent(Bool.self, forKey: .gray) ?? self.gray
+            self.grid = try container.decodeIfPresent(Int.self, forKey: .grid) ?? self.grid
+            self.pickers = try container.decodeIfPresent(Bool.self, forKey: .pickers) ?? self.pickers
+        }
+    }
+
+    public struct Photos: Codable, Equatable {
