     }
     return .color(first)
 }
+
+private let ayuMessagesLock = NSLock()
+private var ayuMessagesThemes: [Bool: PresentationTheme] = [:]
+
+private func ayuMakeMessagesTheme(from theme: PresentationTheme, dark: Bool) -> PresentationTheme {
+    let accent: UInt32 = dark ? 0x0a84ff : 0x007aff
+    let base = dark ? makeDefaultDarkPresentationTheme(preview: false) : theme
+    var result = customizePresentationTheme(base, editing: false, accentColor: UIColor(rgb: accent), outgoingAccentColor: nil, backgroundColors: [], bubbleColors: [accent], animateBubbleColors: false)
+
+    let page = UIColor(rgb: dark ? 0x000000 : 0xffffff)
+    let gray = UIColor(rgb: 0x8e8e93)
+    let chat = result.chat
+    let message = chat.message.withUpdated(
+        incoming: ayuParted(chat.message.incoming, fill: UIColor(rgb: dark ? 0x262629 : 0xe9e9eb), text: dark ? .white : .black),
+        outgoing: ayuParted(chat.message.outgoing, fill: UIColor(rgb: accent), text: .white)
+    )
+    // Dates and service messages are plain gray text. The fill matches the page, so a date
+    // floating over the bubbles while scrolling stays readable and is invisible otherwise.
+    let serviceComponents = chat.serviceMessage.components.withDefaultWallpaper.withUpdated(fill: page, primaryText: gray, dateFillStatic: page, dateFillFloating: page)
+    let serviceMessage = chat.serviceMessage.withUpdated(
+        components: PresentationThemeServiceMessageColor(withDefaultWallpaper: serviceComponents, withCustomWallpaper: serviceComponents),
+        dateTextColor: PresentationThemeVariableColor(color: gray)
+    )
+    let updatedChat = chat.withUpdated(message: message, serviceMessage: serviceMessage)
+    result = PresentationTheme(name: result.name, index: result.index, referenceTheme: result.referenceTheme, overallDarkAppearance: result.overallDarkAppearance, intro: result.intro, passcode: result.passcode, rootController: result.rootController, list: result.list, chatList: result.chatList, chat: updatedChat, actionSheet: result.actionSheet, contextMenu: result.contextMenu, inAppNotification: result.inAppNotification, chart: result.chart, preview: result.preview)
+    return result
+}
+
+/// The colours of Apple's Messages app, whatever theme is selected. Only its light or dark
+/// appearance counts, so there is one theme of each and its identity never changes.
+func ayuMessagesStyleTheme(_ theme: PresentationTheme) -> PresentationTheme {
+    guard AyuMessagesStyle.isEnabled else {
+        return theme
+    }
+    let dark = theme.overallDarkAppearance
+    ayuMessagesLock.lock()
+    defer { ayuMessagesLock.unlock() }
+    if let cached = ayuMessagesThemes[dark] {
+        return cached
+    }
+    let result = ayuMakeMessagesTheme(from: theme, dark: dark)
+    ayuMessagesThemes[dark] = result
+    return result
+}
