index 0000000..3e3c0fa
--- /dev/null
+++ b/submodules/Display/Source/AyuTheme.swift
@@ -0,0 +1,366 @@
+import Foundation
+
+public enum AyuThemeError: LocalizedError {
+    case invalidFile
+    case newerFormat
+    case unreadablePalette
+
+    public var errorDescription: String? {
+        switch self {
+        case .invalidFile:
+            return "Invalid .ayutheme file."
+        case .newerFormat:
+            return "This theme needs a newer version of the app."
+        case .unreadablePalette:
+            return "The palette colors are too close to each other: text would be unreadable."
+        }
+    }
+}
+
+/// A theme file: values for the pixel style, read once at launch. It holds no code.
+public struct AyuTheme: Codable, Equatable {
+    public static let formatName = "ayu-theme-1"
+    public static let fileExtension = "ayutheme"
+    public static let maximumFileBytes = 64 * 1024
+
+    public struct Palette: Codable, Equatable {
+        public var dark: String = "#000000"
+        public var light: String = "#FFFFFF"
+
+        public init() {
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case dark, light
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            self.dark = try container.decodeIfPresent(String.self, forKey: .dark) ?? self.dark
+            self.light = try container.decodeIfPresent(String.self, forKey: .light) ?? self.light
+        }
+    }
+
+    public enum FontChoice: String, Codable {
+        case golos, handjet, plex, system
+
+        public var postScriptName: String? {
+            switch self {
+            case .golos:
+                return "GolosText-Regular"
+            case .handjet:
+                return "Handjet-Regular"
+            case .plex:
+                return "IBMPlexMono-Regular"
+            case .system:
+                return nil
+            }
+        }
+    }
+
+    public struct Fonts: Codable, Equatable {
+        public var body: FontChoice = .golos
+        public var title: FontChoice = .handjet
+        public var label: FontChoice = .plex
+
+        public init() {
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case body, title, label
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            self.body = try container.decodeIfPresent(FontChoice.self, forKey: .body) ?? self.body
+            self.title = try container.decodeIfPresent(FontChoice.self, forKey: .title) ?? self.title
+            self.label = try container.decodeIfPresent(FontChoice.self, forKey: .label) ?? self.label
+        }
+    }
+
+    public struct Icons: Codable, Equatable {
+        /// The size of a pixel of an icon in points. 0 keeps the icons as they are.
+        public var grid: Int = 1
+
+        public init() {
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case grid
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            self.grid = try container.decodeIfPresent(Int.self, forKey: .grid) ?? self.grid
+        }
+    }
+
+    public struct Avatars: Codable, Equatable {
+        /// Cells on a side of the mosaic. 0 keeps the full resolution.
+        public var mosaic: Int = 24
+        public var gray: Bool = true
+
+        public init() {
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case mosaic, gray
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            self.mosaic = try container.decodeIfPresent(Int.self, forKey: .mosaic) ?? self.mosaic
+            self.gray = try container.decodeIfPresent(Bool.self, forKey: .gray) ?? self.gray
+        }
+    }
+
+    public struct Media: Codable, Equatable {
+        /// Stickers, custom emoji and animated icons.
+        public var gray: Bool = true
+        /// The multiplier of their pixel size. 0 keeps the full resolution.
+        public var grid: Int = 1
+
+        public init() {
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case gray, grid
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            self.gray = try container.decodeIfPresent(Bool.self, forKey: .gray) ?? self.gray
+            self.grid = try container.decodeIfPresent(Int.self, forKey: .grid) ?? self.grid
+        }
+    }
+
+    public struct Animation: Codable, Equatable {
+        /// How many values a layer jumps through per second. 0 keeps the smooth animations.
+        public var stepsPerSecond: Int = 20
+
+        public init() {
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case stepsPerSecond
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            self.stepsPerSecond = try container.decodeIfPresent(Int.self, forKey: .stepsPerSecond) ?? self.stepsPerSecond
+        }
+    }
+
+    public struct Chat: Codable, Equatable {
+        public var dots: Bool = true
+        public var bubbleCorner: Int = 6
+
+        public init() {
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case dots, bubbleCorner
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            self.dots = try container.decodeIfPresent(Bool.self, forKey: .dots) ?? self.dots
+            self.bubbleCorner = try container.decodeIfPresent(Int.self, forKey: .bubbleCorner) ?? self.bubbleCorner
+        }
+    }
+
+    public var format: String = AyuTheme.formatName
+    public var id: String
+    public var name: String
+    public var author: String
+    public var version: String
+    public var description: String = ""
+    public var palette = Palette()
+    public var fonts = Fonts()
+    public var icons = Icons()
+    public var avatars = Avatars()
+    public var media = Media()
+    public var animation = Animation()
+    public var chat = Chat()
+
+    public init(id: String, name: String, author: String, version: String, description: String = "") {
+        self.id = id
+        self.name = name
+        self.author = author
+        self.version = version
+        self.description = description
+    }
+
+    private enum CodingKeys: String, CodingKey {
+        case format, id, name, author, version, description, palette, fonts, icons, avatars, media, animation, chat
+    }
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        self.format = try container.decode(String.self, forKey: .format)
+        self.id = try container.decode(String.self, forKey: .id)
+        self.name = try container.decode(String.self, forKey: .name)
+        self.author = try container.decode(String.self, forKey: .author)
+        self.version = try container.decode(String.self, forKey: .version)
+        self.description = try container.decodeIfPresent(String.self, forKey: .description) ?? ""
+        self.palette = try container.decodeIfPresent(Palette.self, forKey: .palette) ?? Palette()
+        self.fonts = try container.decodeIfPresent(Fonts.self, forKey: .fonts) ?? Fonts()
+        self.icons = try container.decodeIfPresent(Icons.self, forKey: .icons) ?? Icons()
+        self.avatars = try container.decodeIfPresent(Avatars.self, forKey: .avatars) ?? Avatars()
+        self.media = try container.decodeIfPresent(Media.self, forKey: .media) ?? Media()
+        self.animation = try container.decodeIfPresent(Animation.self, forKey: .animation) ?? Animation()
+        self.chat = try container.decodeIfPresent(Chat.self, forKey: .chat) ?? Chat()
+    }
+
+    /// The default look of the app.
+    public static let pixel = AyuTheme(id: "pixel", name: "Pixel", author: "AyuGram", version: "1.0", description: "Black and white, square, on a pixel grid.")
+
+    public static func rgb(hex: String) -> UInt32? {
+        guard hex.utf8.count == 7, hex.hasPrefix("#") else {
+            return nil
+        }
+        let digits = hex.dropFirst()
+        guard digits.allSatisfy({ $0.isHexDigit }) else {
+            return nil
+        }
+        return UInt32(digits, radix: 16)
+    }
+
+    private static func luma(_ rgb: UInt32) -> Double {
+        let red = Double((rgb >> 16) & 0xff)
+        let green = Double((rgb >> 8) & 0xff)
+        let blue = Double(rgb & 0xff)
+        return (red * 0.2126 + green * 0.7152 + blue * 0.0722) / 255.0
+    }
+
+    public func validate() throws {
+        let validID = !self.id.isEmpty && self.id.utf8.count <= 64 && self.id.unicodeScalars.allSatisfy { (97 ... 122).contains($0.value) || (48 ... 57).contains($0.value) || $0 == "_" || $0 == "-" }
+        guard self.format == AyuTheme.formatName, validID,
+              !self.name.isEmpty, self.name.count <= 64,
+              !self.author.isEmpty, self.author.count <= 128,
+              !self.version.isEmpty, self.version.count <= 32,
+              self.description.count <= 512,
+              (0 ... 4).contains(self.icons.grid),
+              self.avatars.mosaic == 0 || (8 ... 64).contains(self.avatars.mosaic),
+              (0 ... 8).contains(self.media.grid),
+              self.animation.stepsPerSecond == 0 || (5 ... 60).contains(self.animation.stepsPerSecond),
+              (2 ... 16).contains(self.chat.bubbleCorner),
+              let dark = AyuTheme.rgb(hex: self.palette.dark),
+              let light = AyuTheme.rgb(hex: self.palette.light) else {
+            throw AyuThemeError.invalidFile
+        }
+        guard AyuTheme.luma(light) - AyuTheme.luma(dark) >= 0.4 else {
+            throw AyuThemeError.unreadablePalette
+        }
+    }
+
+    public static func parse(_ data: Data) throws -> AyuTheme {
+        guard !data.isEmpty, data.count <= AyuTheme.maximumFileBytes,
+              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let format = object["format"] as? String else {
+            throw AyuThemeError.invalidFile
+        }
+        if format != AyuTheme.formatName && format.hasPrefix("ayu-theme-") {
+            throw AyuThemeError.newerFormat
+        }
+        guard let theme = try? JSONDecoder().decode(AyuTheme.self, from: data) else {
+            throw AyuThemeError.invalidFile
+        }
+        try theme.validate()
+        return theme
+    }
+
+    public func export() throws -> Data {
+        try self.validate()
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+        return try encoder.encode(self)
+    }
+}
+
+/// Installed themes and the active one. A change applies at the next launch: fonts, shapes and
+/// runtime hooks are set up before the first screen. The keys are also read in AppBundle.m.
+public enum AyuThemeStore {
+    private static let activeKey = "ayu.theme.active"
+    private static let stockKey = "ayu.theme.stock"
+    private static let iconGridKey = "ayu.theme.iconGrid"
+    private static let recoveredKey = "ayu.theme.recovered"
+
+    private static var directory: URL? {
+        return FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?.appendingPathComponent("ayu-themes", isDirectory: true)
+    }
+
+    /// The theme of this launch; nil is the standard look of the app, as in app extensions.
+    public static func loadActive() -> AyuTheme? {
+        if Bundle.main.bundlePath.hasSuffix(".appex") {
+            return nil
+        }
+        let defaults = UserDefaults.standard
+        if defaults.bool(forKey: AyuThemeStore.stockKey) {
+            return nil
+        }
+        if let data = defaults.data(forKey: AyuThemeStore.activeKey), let theme = try? AyuTheme.parse(data) {
+            return theme
+        }
+        return AyuTheme.pixel
+    }
+
+    /// The theme the next launch uses.
+    public static var selected: AyuTheme? {
+        return AyuThemeStore.loadActive()
+    }
+
+    public static func activate(_ theme: AyuTheme?) throws {
+        let defaults = UserDefaults.standard
+        defaults.removeObject(forKey: AyuThemeStore.recoveredKey)
+        guard let theme = theme else {
+            defaults.set(true, forKey: AyuThemeStore.stockKey)
+            return
+        }
+        let data = try theme.export()
+        defaults.set(data, forKey: AyuThemeStore.activeKey)
+        defaults.set(theme.icons.grid, forKey: AyuThemeStore.iconGridKey)
+        defaults.set(false, forKey: AyuThemeStore.stockKey)
+    }
+
+    /// Whether repeated failed launches have switched the theme off.
+    public static var wasSwitchedOffAfterFailedLaunches: Bool {
+        return UserDefaults.standard.bool(forKey: AyuThemeStore.recoveredKey)
+    }
+
+    public static func installed() -> [AyuTheme] {
+        var result: [AyuTheme] = [AyuTheme.pixel]
+        guard let directory = AyuThemeStore.directory, let urls = try? FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: nil) else {
+            return result
+        }
+        var themes: [AyuTheme] = []
+        for url in urls where url.pathExtension == AyuTheme.fileExtension {
+            if let data = try? Data(contentsOf: url), let theme = try? AyuTheme.parse(data), theme.id != AyuTheme.pixel.id {
+                themes.append(theme)
+            }
+        }
+        result.append(contentsOf: themes.sorted(by: { $0.name.lowercased() < $1.name.lowercased() }))
+        return result
+    }
+
+    @discardableResult
+    public static func install(_ data: Data) throws -> AyuTheme {
+        let theme = try AyuTheme.parse(data)
+        guard theme.id != AyuTheme.pixel.id, let directory = AyuThemeStore.directory else {
+            throw AyuThemeError.invalidFile
+        }
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        try theme.export().write(to: directory.appendingPathComponent(theme.id).appendingPathExtension(AyuTheme.fileExtension), options: .atomic)
+        return theme
+    }
+
+    public static func remove(id: String) throws {
+        guard id != AyuTheme.pixel.id, let directory = AyuThemeStore.directory else {
+            return
+        }
+        if AyuThemeStore.selected?.id == id {
+            try AyuThemeStore.activate(AyuTheme.pixel)
+        }
+        try FileManager.default.removeItem(at: directory.appendingPathComponent(id).appendingPathExtension(AyuTheme.fileExtension))
+    }
+}
