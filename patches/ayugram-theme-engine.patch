diff --git a/submodules/SettingsUI/Sources/AyuThemesController.swift b/submodules/SettingsUI/Sources/AyuThemesController.swift
new file mode 100644
index 0000000..43d3a53
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuThemesController.swift
@@ -0,0 +1,194 @@
+import Foundation
+import UIKit
+import UniformTypeIdentifiers
+import Display
+import SwiftSignalKit
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+private final class AyuThemeDocumentPickerDelegate: NSObject, UIDocumentPickerDelegate {
+    let picked: (URL) -> Void
+    private var retainedSelf: AyuThemeDocumentPickerDelegate?
+
+    init(picked: @escaping (URL) -> Void) {
+        self.picked = picked
+        super.init()
+        self.retainedSelf = self
+    }
+
+    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+        self.retainedSelf = nil
+        if let url = urls.first {
+            self.picked(url)
+        }
+    }
+
+    func documentPickerWasCancelled(_ controller: UIDocumentPickerViewController) {
+        self.retainedSelf = nil
+    }
+}
+
+private func ayuThemeAlert(context: AccountContext, title: String, text: String, actions: [TextAlertAction]) {
+    context.sharedContext.mainWindow?.present(textAlertController(context: context, title: title, text: text, actions: actions, actionLayout: actions.count > 2 ? .vertical : .horizontal), on: .root)
+}
+
+private func ayuThemeRestartAlert(context: AccountContext, russian: Bool) {
+    ayuThemeAlert(context: context, title: russian ? "Тема выбрана" : "Theme selected", text: russian ? "Тема применится после перезапуска приложения." : "The theme applies when the app restarts.", actions: [
+        TextAlertAction(type: .genericAction, title: russian ? "Позже" : "Later", action: {}),
+        TextAlertAction(type: .defaultAction, title: russian ? "Закрыть приложение" : "Close the app", action: {
+            exit(0)
+        })
+    ])
+}
+
+/// Reviews a theme file and installs it. The file holds only values, which are validated here.
+public func ayuImportTheme(context: AccountContext, fileURL: URL, completed: (() -> Void)? = nil) {
+    let russian = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+    let scoped = fileURL.startAccessingSecurityScopedResource()
+    defer {
+        if scoped {
+            fileURL.stopAccessingSecurityScopedResource()
+        }
+    }
+    let theme: AyuTheme
+    let data: Data
+    do {
+        data = try Data(contentsOf: fileURL, options: .mappedIfSafe)
+        theme = try AyuTheme.parse(data)
+    } catch {
+        ayuThemeAlert(context: context, title: russian ? "Ошибка темы" : "Theme error", text: error.localizedDescription, actions: [
+            TextAlertAction(type: .defaultAction, title: "OK", action: {})
+        ])
+        return
+    }
+    var text = theme.name + " " + theme.version + "\n" + theme.author
+    if !theme.description.isEmpty {
+        text += "\n\n" + theme.description
+    }
+    let install: (Bool) -> Void = { apply in
+        do {
+            let installed = try AyuThemeStore.install(data)
+            if apply {
+                try AyuThemeStore.activate(installed)
+                ayuThemeRestartAlert(context: context, russian: russian)
+            }
+            completed?()
+        } catch {
+            ayuThemeAlert(context: context, title: russian ? "Ошибка темы" : "Theme error", text: error.localizedDescription, actions: [
+                TextAlertAction(type: .defaultAction, title: "OK", action: {})
+            ])
+        }
+    }
+    ayuThemeAlert(context: context, title: russian ? "Установить тему?" : "Install theme?", text: text, actions: [
+        TextAlertAction(type: .defaultAction, title: russian ? "Установить и применить" : "Install and apply", action: {
+            install(true)
+        }),
+        TextAlertAction(type: .genericAction, title: russian ? "Только установить" : "Install only", action: {
+            install(false)
+        }),
+        TextAlertAction(type: .genericAction, title: russian ? "Отмена" : "Cancel", action: {})
+    ])
+}
+
+func ayuThemesController(context: AccountContext) -> ViewController {
+    let updated = ValuePromise<Int>(0, ignoreRepeated: false)
+    var version = 0
+    let reload: () -> Void = {
+        version += 1
+        updated.set(version)
+    }
+    var themes: [AyuTheme] = []
+
+    let exportTheme: (AyuTheme) -> Void = { theme in
+        guard let data = try? theme.export() else {
+            return
+        }
+        let url = URL(fileURLWithPath: NSTemporaryDirectory()).appendingPathComponent(theme.id).appendingPathExtension(AyuTheme.fileExtension)
+        guard (try? data.write(to: url, options: .atomic)) != nil else {
+            return
+        }
+        context.sharedContext.applicationBindings.presentNativeController(UIActivityViewController(activityItems: [url], applicationActivities: nil))
+    }
+
+    let arguments = AyuSectionedArguments(open: { id in
+        let russian = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        if id == 1 {
+            ayuThemeAlert(context: context, title: russian ? "Стандартный вид" : "Standard look", text: russian ? "Вернуть обычный вид Telegram?" : "Go back to the regular look of Telegram?", actions: [
+                TextAlertAction(type: .genericAction, title: russian ? "Отмена" : "Cancel", action: {}),
+                TextAlertAction(type: .defaultAction, title: russian ? "Вернуть" : "Go back", action: {
+                    try? AyuThemeStore.activate(nil)
+                    reload()
+                    ayuThemeRestartAlert(context: context, russian: russian)
+                })
+            ])
+        } else if id == 1000 {
+            let delegate = AyuThemeDocumentPickerDelegate(picked: { url in
+                ayuImportTheme(context: context, fileURL: url, completed: reload)
+            })
+            let picker = UIDocumentPickerViewController(forOpeningContentTypes: [.item], asCopy: true)
+            picker.delegate = delegate
+            context.sharedContext.applicationBindings.presentNativeController(picker)
+        } else {
+            let index = Int(id) - 2
+            guard index >= 0, index < themes.count else {
+                return
+            }
+            let theme = themes[index]
+            var actions: [TextAlertAction] = [
+                TextAlertAction(type: .defaultAction, title: russian ? "Применить" : "Apply", action: {
+                    do {
+                        try AyuThemeStore.activate(theme)
+                        reload()
+                        ayuThemeRestartAlert(context: context, russian: russian)
+                    } catch {
+                        ayuThemeAlert(context: context, title: russian ? "Ошибка темы" : "Theme error", text: error.localizedDescription, actions: [
+                            TextAlertAction(type: .defaultAction, title: "OK", action: {})
+                        ])
+                    }
+                }),
+                TextAlertAction(type: .genericAction, title: russian ? "Экспортировать файл" : "Export file", action: {
+                    exportTheme(theme)
+                })
+            ]
+            if theme.id != AyuTheme.pixel.id {
+                actions.append(TextAlertAction(type: .destructiveAction, title: russian ? "Удалить" : "Delete", action: {
+                    try? AyuThemeStore.remove(id: theme.id)
+                    reload()
+                }))
+            }
+            actions.append(TextAlertAction(type: .genericAction, title: russian ? "Отмена" : "Cancel", action: {}))
+            var text = theme.author + ", " + theme.version
+            if !theme.description.isEmpty {
+                text += "\n\n" + theme.description
+            }
+            ayuThemeAlert(context: context, title: theme.name, text: text, actions: actions)
+        }
+    }, toggle: { _, _ in })
+
+    let signal = combineLatest(context.sharedContext.presentationData, updated.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let russian = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        themes = AyuThemeStore.installed()
+        let selected = AyuThemeStore.selected
+        var entries: [AyuSectionedEntry] = [
+            .header(0, 0, russian ? "Темы" : "Themes"),
+            .link(0, 1, nil, russian ? "Стандартный вид" : "Standard look", selected == nil ? "✓" : "")
+        ]
+        for (index, theme) in themes.enumerated() {
+            entries.append(.link(0, Int32(index) + 2, nil, theme.name, selected?.id == theme.id ? "✓" : ""))
+        }
+        entries.append(.link(1, 1000, nil, russian ? "Установить файл .ayutheme" : "Install .ayutheme file", ""))
+        var info = russian ? "Тема применяется после перезапуска приложения. Файл темы содержит только настройки и не может запускать код." : "A theme applies when the app restarts. A theme file holds only values and cannot run code."
+        if AyuThemeStore.wasSwitchedOffAfterFailedLaunches {
+            info = (russian ? "Тема отключена: приложение несколько раз подряд не смогло запуститься.\n\n" : "The theme was switched off: the app failed to launch several times in a row.\n\n") + info
+        }
+        entries.append(.info(1, 1001, info))
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(russian ? "Темы" : "Themes"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    return ItemListController(context: context, state: signal)
+}
