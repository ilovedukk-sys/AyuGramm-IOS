+        guard let touch = touches.first else {
+            return
+        }
+        if !self.validated {
+            // In window coordinates, because the chat's list is rotated.
+            let location = touch.location(in: nil)
+            let translation = CGPoint(x: location.x - self.firstLocation.x, y: location.y - self.firstLocation.y)
+            if translation.x > 2.0 || (abs(translation.y) > 2.0 && abs(translation.y) > abs(translation.x) * 2.0) {
+                self.state = .failed
+                return
+            }
+            if abs(translation.x) > 2.0 && abs(translation.y) * 2.0 < abs(translation.x) {
+                self.validated = true
+            }
+        }
+        if self.validated {
+            super.touchesMoved(touches, with: event)
+        }
+    }
