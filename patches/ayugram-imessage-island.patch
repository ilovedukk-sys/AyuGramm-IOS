diff --git a/Telegram/WidgetKitWidget/AyuLiveActivityWidget.swift b/Telegram/WidgetKitWidget/AyuLiveActivityWidget.swift
new file mode 100644
index 0000000..6118f0d
--- /dev/null
+++ b/Telegram/WidgetKitWidget/AyuLiveActivityWidget.swift
@@ -0,0 +1,202 @@
+#if arch(arm64) || arch(x86_64)
+
+import SwiftUI
+import WidgetKit
+import ActivityKit
+import AyuLiveActivityAttributes
+
+// The Lock Screen and Dynamic Island look of AyuGram's Live Activities.
+
+@available(iOSApplicationExtension 16.2, iOS 16.2, *)
+private extension AyuActivityKind {
+    var symbolName: String {
+        switch self {
+        case .download:
+            return "arrow.down.circle.fill"
+        case .upload:
+            return "arrow.up.circle.fill"
+        case .call:
+            return "phone.fill"
+        case .groupCall:
+            return "waveform"
+        case .location:
+            return "location.fill"
+        }
+    }
+
+    var tint: Color {
+        switch self {
+        case .download, .upload:
+            return .blue
+        case .call, .groupCall:
+            return .green
+        case .location:
+            return .cyan
+        }
+    }
+}
+
+@available(iOSApplicationExtension 16.2, iOS 16.2, *)
+private struct AyuActivityIcon: View {
+    let kind: AyuActivityKind
+    let state: AyuActivityContentState
+
+    var body: some View {
+        Image(systemName: self.state.isFinished ? "checkmark.circle.fill" : (self.state.isMuted ? "mic.slash.fill" : self.kind.symbolName))
+            .foregroundColor(self.kind.tint)
+    }
+}
+
+@available(iOSApplicationExtension 16.2, iOS 16.2, *)
+private struct AyuActivityRing: View {
+    let progress: Double
+    let tint: Color
+
+    var body: some View {
+        ZStack {
+            Circle()
+                .stroke(self.tint.opacity(0.3), lineWidth: 3.0)
+            Circle()
+                .trim(from: 0.0, to: CGFloat(max(0.02, min(1.0, self.progress))))
+                .stroke(self.tint, style: StrokeStyle(lineWidth: 3.0, lineCap: .round))
+                .rotationEffect(.degrees(-90.0))
+        }
+        .frame(width: 18.0, height: 18.0)
+    }
+}
+
+@available(iOSApplicationExtension 16.2, iOS 16.2, *)
+private struct AyuActivityValue: View {
+    let kind: AyuActivityKind
+    let state: AyuActivityContentState
+    let compact: Bool
+
+    var body: some View {
+        if self.state.isFinished {
+            Image(systemName: "checkmark")
+                .foregroundColor(self.kind.tint)
+        } else if let progress = self.state.progress {
+            if self.compact {
+                AyuActivityRing(progress: progress, tint: self.kind.tint)
+            } else {
+                Text("\(Int((progress * 100.0).rounded()))%")
+                    .font(.system(.body, design: .rounded).weight(.semibold))
+                    .monospacedDigit()
+                    .foregroundColor(self.kind.tint)
+            }
+        } else if let timerStart = self.state.timerStart {
+            Text(timerStart, style: .timer)
+                .monospacedDigit()
+                .multilineTextAlignment(.trailing)
+                .foregroundColor(self.kind.tint)
+                .frame(maxWidth: self.compact ? 48.0 : 64.0)
+        } else if let timerEnd = self.state.timerEnd {
+            Text(timerInterval: Date() ... max(Date(), timerEnd), countsDown: true)
+                .monospacedDigit()
+                .multilineTextAlignment(.trailing)
+                .foregroundColor(self.kind.tint)
+                .frame(maxWidth: self.compact ? 48.0 : 64.0)
+        } else {
+            Image(systemName: self.kind.symbolName)
+                .foregroundColor(self.kind.tint)
+        }
+    }
+}
+
+@available(iOSApplicationExtension 16.2, iOS 16.2, *)
+private struct AyuActivityBar: View {
+    let progress: Double
+    let tint: Color
+
+    var body: some View {
+        GeometryReader { geometry in
+            ZStack(alignment: .leading) {
+                Capsule()
+                    .fill(self.tint.opacity(0.25))
+                Capsule()
+                    .fill(self.tint)
+                    .frame(width: max(6.0, geometry.size.width * CGFloat(max(0.0, min(1.0, self.progress)))))
+            }
+        }
+        .frame(height: 6.0)
+    }
+}
+
+@available(iOSApplicationExtension 16.2, iOS 16.2, *)
+private struct AyuActivityLockScreenView: View {
+    let kind: AyuActivityKind
+    let state: AyuActivityContentState
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 10.0) {
+            HStack(spacing: 12.0) {
+                AyuActivityIcon(kind: self.kind, state: self.state)
+                    .font(.system(size: 28.0))
+                VStack(alignment: .leading, spacing: 2.0) {
+                    Text(self.state.title)
+                        .font(.headline)
+                        .lineLimit(1)
+                    Text(self.state.subtitle)
+                        .font(.subheadline)
+                        .foregroundColor(.secondary)
+                        .lineLimit(1)
+                }
+                Spacer(minLength: 8.0)
+                AyuActivityValue(kind: self.kind, state: self.state, compact: false)
+            }
+            if let progress = self.state.progress, !self.state.isFinished {
+                AyuActivityBar(progress: progress, tint: self.kind.tint)
+            }
+        }
+        .padding(16.0)
+    }
+}
+
+@available(iOSApplicationExtension 16.2, iOS 16.2, *)
+struct AyuLiveActivityWidget: Widget {
+    var body: some WidgetConfiguration {
+        ActivityConfiguration(for: AyuActivityAttributes.self) { context in
+            AyuActivityLockScreenView(kind: context.attributes.kind, state: context.state)
+        } dynamicIsland: { context in
+            DynamicIsland {
+                DynamicIslandExpandedRegion(.leading) {
+                    AyuActivityIcon(kind: context.attributes.kind, state: context.state)
+                        .font(.system(size: 34.0))
+                }
+                DynamicIslandExpandedRegion(.trailing) {
+                    AyuActivityValue(kind: context.attributes.kind, state: context.state, compact: false)
+                }
+                DynamicIslandExpandedRegion(.center) {
+                    VStack(spacing: 2.0) {
+                        Text(context.state.title)
+                            .font(.headline)
+                            .lineLimit(1)
+                        Text(context.state.subtitle)
+                            .font(.caption)
+                            .foregroundColor(.secondary)
+                            .lineLimit(1)
+                    }
+                }
+                DynamicIslandExpandedRegion(.bottom) {
+                    if let progress = context.state.progress, !context.state.isFinished {
+                        AyuActivityBar(progress: progress, tint: context.attributes.kind.tint)
+                            .padding(.top, 6.0)
+                    }
+                }
+            } compactLeading: {
+                AyuActivityIcon(kind: context.attributes.kind, state: context.state)
+            } compactTrailing: {
+                AyuActivityValue(kind: context.attributes.kind, state: context.state, compact: true)
+            } minimal: {
+                if let progress = context.state.progress, !context.state.isFinished {
+                    AyuActivityRing(progress: progress, tint: context.attributes.kind.tint)
+                } else {
+                    AyuActivityIcon(kind: context.attributes.kind, state: context.state)
+                }
+            }
+            .keylineTint(context.attributes.kind.tint)
+        }
+    }
+}
+
+#endif
