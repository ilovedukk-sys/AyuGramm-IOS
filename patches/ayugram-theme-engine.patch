+
+static void AyuLoadThemeRuntime(void) {
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        if ([[NSBundle mainBundle].bundlePath hasSuffix:@".appex"]) {
+            return;
+        }
+        NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+        if ([defaults boolForKey:@"ayu.theme.stock"]) {
+            return;
+        }
+        // Launches that keep dying within 20 seconds switch the theme off, so that a theme can always be replaced.
+        NSInteger attempts = [defaults integerForKey:@"ayu.theme.launchAttempts"] + 1;
+        if (attempts > 3) {
+            [defaults removeObjectForKey:@"ayu.theme.launchAttempts"];
+            [defaults setBool:YES forKey:@"ayu.theme.stock"];
+            [defaults setBool:YES forKey:@"ayu.theme.recovered"];
+            return;
+        }
+        [defaults setInteger:attempts forKey:@"ayu.theme.launchAttempts"];
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(20.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+            [[NSUserDefaults standardUserDefaults] removeObjectForKey:@"ayu.theme.launchAttempts"];
+        });
+        AyuPixelStyleEnabled = YES;
+        id grid = [defaults objectForKey:@"ayu.theme.iconGrid"];
+        if ([grid isKindOfClass:[NSNumber class]]) {
+            AyuIconGrid = [grid doubleValue];
+        }
+        id squareCorners = [defaults objectForKey:@"ayu.theme.squareCorners"];
+        if ([squareCorners isKindOfClass:[NSNumber class]]) {
+            AyuSquareCorners = [squareCorners boolValue];
+        }
+    });
+}
 
