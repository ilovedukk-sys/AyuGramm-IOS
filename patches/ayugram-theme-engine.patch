+    /// The default look of the app.
+    public static let pixel = AyuTheme(id: "pixel", name: "Pixel", author: "AyuGram", version: "1.0", description: "Black and white, square, on a pixel grid.")
+
+    /// The PostScript name of a font choice; nil is the system font.
+    public func postScriptName(forFont choice: String) -> String? {
+        if let builtIn = AyuTheme.builtInFonts[choice] {
+            return builtIn
+        }
+        return self.customFonts.first(where: { $0.id == choice })?.postScriptName
+    }
+
+    public static func rgb(hex: String) -> UInt32? {
+        guard hex.utf8.count == 7, hex.hasPrefix("#") else {
+            return nil
+        }
+        let digits = hex.dropFirst()
+        guard digits.allSatisfy({ $0.isHexDigit }) else {
+            return nil
+        }
+        return UInt32(digits, radix: 16)
+    }
+
+    private static func luma(_ rgb: UInt32) -> Double {
+        let red = Double((rgb >> 16) & 0xff)
+        let green = Double((rgb >> 8) & 0xff)
+        let blue = Double(rgb & 0xff)
+        return (red * 0.2126 + green * 0.7152 + blue * 0.0722) / 255.0
+    }
+
+    private static func isValidID(_ text: String) -> Bool {
+        return !text.isEmpty && text.utf8.count <= 64 && text.unicodeScalars.allSatisfy { (97 ... 122).contains($0.value) || (48 ... 57).contains($0.value) || $0 == "_" || $0 == "-" }
+    }
+
+    public func validate() throws {
+        guard self.format == AyuTheme.formatName, AyuTheme.isValidID(self.id),
+              !self.name.isEmpty, self.name.count <= 64,
+              !self.author.isEmpty, self.author.count <= 128,
+              !self.version.isEmpty, self.version.count <= 32,
+              self.description.count <= 512,
+              (0 ... 4).contains(self.icons.grid),
+              self.avatars.mosaic == 0 || (8 ... 64).contains(self.avatars.mosaic),
+              (0 ... 8).contains(self.media.grid),
+              (0 ... 8).contains(self.photos.grid),
+              self.animation.stepsPerSecond == 0 || (5 ... 60).contains(self.animation.stepsPerSecond),
+              (2 ... 16).contains(self.chat.bubbleCorner),
+              let dark = AyuTheme.rgb(hex: self.palette.dark),
+              let light = AyuTheme.rgb(hex: self.palette.light) else {
+            throw AyuThemeError.invalidFile
+        }
+        guard AyuTheme.luma(light) - AyuTheme.luma(dark) >= 0.4 else {
+            throw AyuThemeError.unreadablePalette
+        }
+        let customIDs = self.customFonts.map { $0.id }
+        guard customIDs.count <= AyuTheme.maximumFontCount, Set(customIDs).count == customIDs.count,
+              customIDs.allSatisfy({ AyuTheme.isValidID($0) && AyuTheme.builtInFonts[$0] == nil }) else {
+            throw AyuThemeError.invalidFile
+        }
+        for choice in [self.fonts.body, self.fonts.title, self.fonts.label] {
+            guard AyuTheme.builtInFonts[choice] != nil || customIDs.contains(choice) else {
+                throw AyuThemeError.invalidFile
+            }
+        }
+    }
+
+    private static func postScriptName(ofFont data: Data) throws -> String {
+        let magic = data.prefix(4)
+        let known: [Data] = [Data([0x00, 0x01, 0x00, 0x00]), Data("OTTO".utf8), Data("true".utf8)]
+        guard data.count <= AyuTheme.maximumFontBytes, known.contains(magic),
+              let provider = CGDataProvider(data: data as CFData), let font = CGFont(provider),
+              let name = font.postScriptName as String?, !name.isEmpty else {
+            throw AyuThemeError.invalidFont
+        }
+        return name
+    }
+
+    /// Reads a theme file and checks its fonts. The result still carries the fonts.
+    public static func parse(_ data: Data) throws -> AyuTheme {
+        guard !data.isEmpty, data.count <= AyuTheme.maximumFileBytes,
+              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let format = object["format"] as? String else {
+            throw AyuThemeError.invalidFile
+        }
+        if format != AyuTheme.formatName && format.hasPrefix("ayu-theme-") {
+            throw AyuThemeError.newerFormat
+        }
+        guard var theme = try? JSONDecoder().decode(AyuTheme.self, from: data) else {
+            throw AyuThemeError.invalidFile
+        }
+        try theme.validate()
+        for index in theme.customFonts.indices {
+            guard let file = theme.customFonts[index].file, let fontData = Data(base64Encoded: file) else {
+                throw AyuThemeError.invalidFont
+            }
+            theme.customFonts[index].postScriptName = try AyuTheme.postScriptName(ofFont: fontData)
+        }
+        return theme
+    }
+
+    /// Reads an installed theme, whose fonts are stored next to it.
+    public static func parseInstalled(_ data: Data) throws -> AyuTheme {
+        guard let theme = try? JSONDecoder().decode(AyuTheme.self, from: data) else {
+            throw AyuThemeError.invalidFile
+        }
+        try theme.validate()
+        guard theme.customFonts.allSatisfy({ $0.file == nil && $0.postScriptName != nil }) else {
+            throw AyuThemeError.invalidFile
+        }
+        return theme
+    }
+
+    public func encoded() throws -> Data {
+        try self.validate()
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+        return try encoder.encode(self)
+    }
+}
+
+/// Installed themes and the active one. A change applies at the next launch: fonts, shapes and
+/// runtime hooks are set up before the first screen. The keys are also read in AppBundle.m.
+public enum AyuThemeStore {
+    private static let activeKey = "ayu.theme.active"
+    private static let stockKey = "ayu.theme.stock"
+    private static let iconGridKey = "ayu.theme.iconGrid"
+    private static let squareCornersKey = "ayu.theme.squareCorners"
+    private static let recoveredKey = "ayu.theme.recovered"
+
+    private static var directory: URL? {
+        return FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?.appendingPathComponent("ayu-themes", isDirectory: true)
+    }
+
+    private static func fontsDirectory(themeID: String) -> URL? {
+        return AyuThemeStore.directory?.appendingPathComponent(themeID + ".fonts", isDirectory: true)
+    }
+
+    /// The theme of this launch; nil is the standard look of the app, as in app extensions.
+    public static func loadActive() -> AyuTheme? {
+        if Bundle.main.bundlePath.hasSuffix(".appex") {
+            return nil
+        }
+        let defaults = UserDefaults.standard
+        if defaults.bool(forKey: AyuThemeStore.stockKey) {
+            return nil
+        }
+        if let data = defaults.data(forKey: AyuThemeStore.activeKey), let theme = try? AyuTheme.parseInstalled(data) {
+            return theme
+        }
+        return AyuTheme.pixel
+    }
+
+    /// Makes the fonts of the active theme available to this launch.
+    public static func registerFonts(of theme: AyuTheme) {
+        guard let directory = AyuThemeStore.fontsDirectory(themeID: theme.id) else {
+            return
+        }
+        for font in theme.customFonts {
+            let _ = CTFontManagerRegisterFontsForURL(directory.appendingPathComponent(font.id) as CFURL, .process, nil)
+        }
+    }
+
+    /// The theme the next launch uses.
+    public static var selected: AyuTheme? {
+        return AyuThemeStore.loadActive()
+    }
+
+    public static func activate(_ theme: AyuTheme?) throws {
+        let defaults = UserDefaults.standard
+        defaults.removeObject(forKey: AyuThemeStore.recoveredKey)
+        guard let theme = theme else {
+            defaults.set(true, forKey: AyuThemeStore.stockKey)
+            return
+        }
+        let data = try theme.encoded()
+        defaults.set(data, forKey: AyuThemeStore.activeKey)
+        defaults.set(theme.icons.grid, forKey: AyuThemeStore.iconGridKey)
+        defaults.set(theme.shapes.corners == .square, forKey: AyuThemeStore.squareCornersKey)
+        defaults.set(false, forKey: AyuThemeStore.stockKey)
+    }
+
+    /// Whether repeated failed launches have switched the theme off.
+    public static var wasSwitchedOffAfterFailedLaunches: Bool {
+        return UserDefaults.standard.bool(forKey: AyuThemeStore.recoveredKey)
+    }
+
+    public static func installed() -> [AyuTheme] {
+        var result: [AyuTheme] = [AyuTheme.pixel]
+        guard let directory = AyuThemeStore.directory, let urls = try? FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: nil) else {
+            return result
+        }
+        var themes: [AyuTheme] = []
+        for url in urls where url.pathExtension == AyuTheme.fileExtension {
+            if let data = try? Data(contentsOf: url), let theme = try? AyuTheme.parseInstalled(data), theme.id != AyuTheme.pixel.id {
+                themes.append(theme)
+            }
+        }
+        result.append(contentsOf: themes.sorted(by: { $0.name.lowercased() < $1.name.lowercased() }))
+        return result
+    }
+
+    /// Stores a theme file, with its fonts as separate files so that each launch reads only the small part.
+    @discardableResult
+    public static func install(_ data: Data) throws -> AyuTheme {
+        var theme = try AyuTheme.parse(data)
+        guard theme.id != AyuTheme.pixel.id, let directory = AyuThemeStore.directory, let fontsDirectory = AyuThemeStore.fontsDirectory(themeID: theme.id) else {
+            throw AyuThemeError.invalidFile
+        }
+        let fileManager = FileManager.default
+        try fileManager.createDirectory(at: directory, withIntermediateDirectories: true)
+        try? fileManager.removeItem(at: fontsDirectory)
+        if !theme.customFonts.isEmpty {
+            try fileManager.createDirectory(at: fontsDirectory, withIntermediateDirectories: true)
+        }
+        for index in theme.customFonts.indices {
+            guard let file = theme.customFonts[index].file, let fontData = Data(base64Encoded: file) else {
+                throw AyuThemeError.invalidFont
+            }
+            try fontData.write(to: fontsDirectory.appendingPathComponent(theme.customFonts[index].id), options: .atomic)
+            theme.customFonts[index].file = nil
+        }
+        try theme.encoded().write(to: directory.appendingPathComponent(theme.id).appendingPathExtension(AyuTheme.fileExtension), options: .atomic)
+        return theme
+    }
+
+    /// A theme file with its fonts back inside, ready to share.
+    public static func exportData(for theme: AyuTheme) throws -> Data {
+        var exported = theme
+        for index in exported.customFonts.indices {
+            guard let fontsDirectory = AyuThemeStore.fontsDirectory(themeID: theme.id) else {
+                throw AyuThemeError.invalidFont
+            }
+            let fontData = try Data(contentsOf: fontsDirectory.appendingPathComponent(exported.customFonts[index].id))
+            exported.customFonts[index].file = fontData.base64EncodedString()
+            exported.customFonts[index].postScriptName = nil
+        }
+        return try exported.encoded()
+    }
+
+    public static func remove(id: String) throws {
+        guard id != AyuTheme.pixel.id, let directory = AyuThemeStore.directory, let fontsDirectory = AyuThemeStore.fontsDirectory(themeID: id) else {
+            return
+        }
+        if AyuThemeStore.selected?.id == id {
+            try AyuThemeStore.activate(AyuTheme.pixel)
+        }
+        try? FileManager.default.removeItem(at: fontsDirectory)
+        try FileManager.default.removeItem(at: directory.appendingPathComponent(id).appendingPathExtension(AyuTheme.fileExtension))
+    }
+}
