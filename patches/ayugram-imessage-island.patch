+import Foundation
+import UIKit
+import ActivityKit
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import FetchManagerImpl
+import TelegramPresentationData
+import TelegramStringFormatting
+import AyuLiveActivityAttributes
+
+@available(iOS 16.2, *)
+private final class AyuActivitySlot {
+    private let kind: AyuActivityKind
+    private var activity: Activity<AyuActivityAttributes>?
+    private var lastState: AyuActivityContentState?
+    private var lastAttempt: Double = 0.0
+
+    init(kind: AyuActivityKind) {
+        self.kind = kind
+    }
+
+    func update(_ state: AyuActivityContentState) {
+        let timestamp = CFAbsoluteTimeGetCurrent()
+        guard let activity = self.activity else {
+            // iOS only starts an activity for an app in the foreground, so a refused start is tried again later.
+            if timestamp < self.lastAttempt + 5.0 || !ActivityAuthorizationInfo().areActivitiesEnabled {
+                return
+            }
+            self.lastAttempt = timestamp
+            do {
+                self.activity = try Activity.request(attributes: AyuActivityAttributes(kind: self.kind), content: ActivityContent(state: state, staleDate: nil), pushType: nil)
+                self.lastState = state
+            } catch let error {
+                Logger.shared.log("AyuGram", "Live Activity not started: \(error)")
+            }
+            return
+        }
+        if state == self.lastState {
+            return
+        }
+        // Progress is sent once a second at most: iOS throttles an activity that updates more often.
+        if let lastState = self.lastState, lastState.title == state.title, lastState.isMuted == state.isMuted, timestamp < self.lastAttempt + 1.0 {
+            return
+        }
+        self.lastAttempt = timestamp
+        self.lastState = state
+        Task {
+            await activity.update(ActivityContent(state: state, staleDate: nil))
+        }
+    }
+
+    func finish(finishedSubtitle: String?) {
+        guard let activity = self.activity else {
+            return
+        }
+        self.activity = nil
+        let lastState = self.lastState
+        self.lastState = nil
+        self.lastAttempt = 0.0
+        Task {
+            if let finishedSubtitle, var state = lastState {
+                state.subtitle = finishedSubtitle
+                state.progress = 1.0
+                state.isFinished = true
+                await activity.end(ActivityContent(state: state, staleDate: nil), dismissalPolicy: .after(Date(timeIntervalSinceNow: 4.0)))
+            } else {
+                await activity.end(nil, dismissalPolicy: .immediate)
+            }
+        }
+    }
+
+    /// Activities left over when the app was closed by the system: nothing updates them any more.
+    static func endLeftovers() {
+        Task {
+            for activity in Activity<AyuActivityAttributes>.activities {
+                await activity.end(nil, dismissalPolicy: .immediate)
+            }
+        }
+    }
+}
+
+/// Shows what the app is doing in the Dynamic Island and on the Lock Screen, as Apple's apps do.
+///
+/// iOS 26 has a system progress UI for long transfers that also keeps the app running after it
+/// is closed, so downloads and uploads use that (SharedWakeupManager). Everything else, and
+/// transfers on older systems, is a Live Activity drawn by the widget extension. A call that
+/// goes through CallKit is left to the system, which already shows it.
+final class AyuLiveActivities {
+    private struct DownloadItem {
+        var size: Int64
+        var name: String?
+        var progress: Double
+    }
+
+    private weak var wakeupManager: SharedWakeupManager?
+    private let context: AccountContextImpl
+    private var slots: [AyuActivityKind: AnyObject] = [:]
+
+    private let downloadsDisposable = MetaDisposable()
+    private let uploadsDisposable = MetaDisposable()
+    private let callDisposable = MetaDisposable()
+    private let groupCallDisposable = MetaDisposable()
+    private let locationDisposable = MetaDisposable()
+
+    private var downloadBatch: [FetchManagerLocationEntryId: DownloadItem] = [:]
+    private var lastDownloadPush: Double = 0.0
+    private var lastDownloadCount: Int = 0
+    private var uploadBatch: [EngineMessage.Id: Float] = [:]
+
+    init(context: AccountContextImpl, wakeupManager: SharedWakeupManager) {
+        self.context = context
+        self.wakeupManager = wakeupManager
+
+        if #available(iOS 16.2, *) {
+            AyuActivitySlot.endLeftovers()
+        }
+        self.observeDownloads()
+        self.observeUploads()
+        self.observeCalls()
+        self.observeLocation()
+    }
+
+    deinit {
+        self.downloadsDisposable.dispose()
+        self.uploadsDisposable.dispose()
+        self.callDisposable.dispose()
+        self.groupCallDisposable.dispose()
+        self.locationDisposable.dispose()
+        self.wakeupManager?.ayuUpdateDownloads(nil)
+    }
+
+    private var presentationData: PresentationData {
+        return self.context.sharedContext.currentPresentationData.with { $0 }
+    }
+
+    private var ru: Bool {
+        return self.presentationData.strings.baseLanguageCode.hasPrefix("ru")
+    }
+
+    private func set(_ kind: AyuActivityKind, _ state: AyuActivityContentState?, finishedSubtitle: String? = nil) {
+        guard #available(iOS 16.2, *) else {
+            return
+        }
+        let slot: AyuActivitySlot
+        if let current = self.slots[kind] as? AyuActivitySlot {
+            slot = current
+        } else {
+            slot = AyuActivitySlot(kind: kind)
+            self.slots[kind] = slot
+        }
+        if let state {
+            slot.update(state)
+        } else {
+            slot.finish(finishedSubtitle: finishedSubtitle)
+        }
+    }
+
+    private func filesString(_ count: Int) -> String {
+        if !self.ru {
+            return count == 1 ? "1 file" : "\(count) files"
+        }
+        let tens = count % 100
+        let ones = count % 10
+        if tens >= 11 && tens <= 14 {
+            return "\(count) файлов"
+        } else if ones == 1 {
+            return "\(count) файл"
+        } else if ones >= 2 && ones <= 4 {
+            return "\(count) файла"
+        } else {
+            return "\(count) файлов"
+        }
+    }
+
+    // MARK: Downloads
+
+    private func observeDownloads() {
+        guard let fetchManager = self.context.fetchManager as? FetchManagerImpl else {
+            return
+        }
+        let engine = self.context.engine
+        self.downloadsDisposable.set((fetchManager.entriesSummary
+        |> mapToSignal { entries -> Signal<[(FetchManagerEntrySummary, Double)], NoError> in
+            let active = entries.filter { !$0.isPaused }
+            if active.isEmpty {
+                return .single([])
+            }
+            return combineLatest(queue: .mainQueue(), active.map { entry -> Signal<(FetchManagerEntrySummary, Double), NoError> in
+                return engine.resources.status(resource: EngineMediaResource(entry.resourceReference.resource))
+                |> map { status -> (FetchManagerEntrySummary, Double) in
+                    switch status {
+                    case .Local:
+                        return (entry, 1.0)
+                    case .Remote:
+                        return (entry, 0.0)
+                    case let .Paused(value):
+                        return (entry, Double(value))
+                    case let .Fetching(_, value):
+                        return (entry, Double(value))
+                    }
+                }
+            })
+        }
+        |> deliverOnMainQueue).startStrict(next: { [weak self] items in
+            self?.updateDownloads(items)
+        }))
+    }
+
+    private func updateDownloads(_ items: [(FetchManagerEntrySummary, Double)]) {
+        if items.isEmpty {
+            let hadItems = !self.downloadBatch.isEmpty
+            self.downloadBatch.removeAll()
+            self.lastDownloadCount = 0
+            self.wakeupManager?.ayuUpdateDownloads(nil)
+            self.set(.download, nil, finishedSubtitle: hadItems ? (self.ru ? "Скачивание завершено" : "Download complete") : nil)
+            return
+        }
+        // Finished files stay in the batch, so the bar keeps moving forward until all of them are done.
+        for key in self.downloadBatch.keys {
+            self.downloadBatch[key]?.progress = 1.0
+        }
+        for (entry, progress) in items {
+            let file = entry.mediaReference?.media as? TelegramMediaFile
+            let size = entry.resourceReference.resource.size ?? file?.size ?? (1024 * 1024)
+            self.downloadBatch[entry.id] = DownloadItem(size: size, name: file?.fileName, progress: progress)
+        }
+
+        var total: Int64 = 0
+        var done: Double = 0.0
+        for item in self.downloadBatch.values {
+            total += item.size
+            done += Double(item.size) * item.progress
+        }
+        let progress = total == 0 ? 0.0 : done / Double(total)
+
+        // At most twice a second, unless the number of files changes.
+        let timestamp = CFAbsoluteTimeGetCurrent()
+        if items.count == self.lastDownloadCount && timestamp < self.lastDownloadPush + 0.5 {
+            return
+        }
+        self.lastDownloadPush = timestamp
+        self.lastDownloadCount = items.count
+
+        let presentationData = self.presentationData
+        let formatting = DataSizeStringFormatting(presentationData: presentationData)
+        let title: String
+        if items.count == 1, let name = (items[0].0.mediaReference?.media as? TelegramMediaFile)?.fileName {
+            title = name
+        } else {
+            title = (self.ru ? "Скачивание: " : "Downloading ") + self.filesString(items.count)
+        }
+        let doneString = dataSizeString(Int64(done), formatting: formatting)
+        let totalString = dataSizeString(total, formatting: formatting)
+        let subtitle = self.ru ? "\(doneString) из \(totalString)" : "\(doneString) of \(totalString)"
+
+        self.wakeupManager?.ayuUpdateDownloads((title: title, subtitle: subtitle, progress: Float(progress)))
+        if self.wakeupManager?.ayuDownloadsUseSystemUI == true {
+            self.set(.download, nil)
+        } else {
+            self.set(.download, AyuActivityContentState(title: title, subtitle: subtitle, progress: progress))
+        }
+    }
+
+    // MARK: Uploads
+
+    private func observeUploads() {
+        // iOS 26 shows media uploads through SharedWakeupManager.
+        if #available(iOS 26.0, *) {
+            return
+        }
+        self.uploadsDisposable.set((self.context.account.pendingMessageManager.pendingMediaUploads
+        |> deliverOnMainQueue).startStrict(next: { [weak self] uploads in
+            self?.updateUploads(uploads)
+        }))
+    }
+
+    private func updateUploads(_ uploads: [EngineMessage.Id: Float]) {
+        if uploads.isEmpty {
+            let hadItems = !self.uploadBatch.isEmpty
+            self.uploadBatch.removeAll()
+            self.set(.upload, nil, finishedSubtitle: hadItems ? (self.ru ? "Отправлено" : "Sent") : nil)
+            return
+        }
+        for key in self.uploadBatch.keys {
+            self.uploadBatch[key] = 1.0
+        }
+        for (id, progress) in uploads {
+            self.uploadBatch[id] = progress
+        }
+        let progress = self.uploadBatch.values.reduce(0.0) { $0 + Double($1) } / Double(self.uploadBatch.count)
+        let title = (self.ru ? "Отправка: " : "Sending ") + self.filesString(uploads.count)
+        self.set(.upload, AyuActivityContentState(title: title, subtitle: "\(Int((progress * 100.0).rounded()))%", progress: progress))
+    }
+
+    // MARK: Calls
+
+    private func observeCalls() {
+        guard let callManager = self.context.sharedContext.callManager else {
+            return
+        }
+        let ru = self.ru
+        self.callDisposable.set((callManager.currentCallSignal
+        |> mapToSignal { call -> Signal<AyuActivityContentState?, NoError> in
+            guard let call, !call.isIntegratedWithCallKit else {
+                return .single(nil)
+            }
+            let title = call.peer?.compactDisplayTitle ?? (ru ? "Звонок" : "Call")
+            return combineLatest(call.state, call.isMuted)
+            |> map { state, isMuted -> AyuActivityContentState? in
+                switch state.state {
+                case let .active(timestamp, _, _):
+                    return AyuActivityContentState(title: title, subtitle: isMuted ? (ru ? "Микрофон выключен" : "Muted") : (ru ? "Звонок" : "Call"), timerStart: Date(timeIntervalSinceReferenceDate: timestamp), isMuted: isMuted)
+                case let .reconnecting(timestamp, _, _):
+                    return AyuActivityContentState(title: title, subtitle: ru ? "Восстановление связи…" : "Reconnecting…", timerStart: Date(timeIntervalSinceReferenceDate: timestamp), isMuted: isMuted)
+                case .waiting, .requesting, .connecting:
+                    return AyuActivityContentState(title: title, subtitle: ru ? "Соединение…" : "Connecting…", isMuted: isMuted)
+                case .ringing:
+                    return AyuActivityContentState(title: title, subtitle: ru ? "Гудки…" : "Ringing…", isMuted: isMuted)
+                case .terminating, .terminated:
+                    return nil
+                }
+            }
+        }
+        |> deliverOnMainQueue).startStrict(next: { [weak self] state in
+            self?.set(.call, state)
+        }))
+
+        self.groupCallDisposable.set((callManager.currentGroupCallSignal
+        |> mapToSignal { call -> Signal<AyuActivityContentState?, NoError> in
+            guard case let .group(groupCall)? = call else {
+                return .single(nil)
+            }
+            let start = Date()
+            let peerTitle: Signal<String?, NoError>
+            if let peerId = groupCall.peerId {
+                peerTitle = groupCall.accountContext.engine.data.get(TelegramEngine.EngineData.Item.Peer.Peer(id: peerId))
+                |> map { peer -> String? in
+                    return peer?.compactDisplayTitle
+                }
+            } else {
+                peerTitle = .single(nil)
+            }
+            return combineLatest(peerTitle, groupCall.isMuted)
+            |> map { title, isMuted -> AyuActivityContentState? in
+                return AyuActivityContentState(title: title ?? (ru ? "Голосовой чат" : "Voice chat"), subtitle: isMuted ? (ru ? "Микрофон выключен" : "Muted") : (ru ? "Вас слышно" : "You are live"), timerStart: start, isMuted: isMuted)
+            }
+        }
+        |> deliverOnMainQueue).startStrict(next: { [weak self] state in
+            self?.set(.groupCall, state)
+        }))
+    }
+
+    // MARK: Live location
+
+    private func observeLocation() {
+        guard let summaryManager = self.context.liveLocationManager?.summaryManager else {
+            return
+        }
+        self.locationDisposable.set((summaryManager.broadcastingToMessages()
+        |> deliverOnMainQueue).startStrict(next: { [weak self] messages in
+            guard let self else {
+                return
+            }
+            guard let message = messages.values.first else {
+                self.set(.location, nil)
+                return
+            }
+            var end: Date?
+            var isIndefinite = false
+            for message in messages.values {
+                for media in message.media {
+                    if let map = media as? TelegramMediaMap, let timeout = map.liveBroadcastingTimeout {
+                        if timeout == liveLocationIndefinitePeriod {
+                            isIndefinite = true
+                        } else {
+                            let date = Date(timeIntervalSince1970: Double(message.timestamp) + Double(timeout))
+                            end = max(end ?? date, date)
+                        }
+                    }
+                }
+            }
+            let peerTitle = message.peers[message.id.peerId].flatMap { EnginePeer($0).compactDisplayTitle }
+            let subtitle: String
+            if messages.count == 1, let peerTitle {
+                subtitle = peerTitle
+            } else {
+                subtitle = (self.ru ? "Чатов: " : "Chats: ") + "\(messages.count)"
+            }
+            self.set(.location, AyuActivityContentState(title: self.ru ? "Геопозиция передаётся" : "Sharing location", subtitle: subtitle, timerEnd: isIndefinite ? nil : end))
+        }))
+    }
+}
