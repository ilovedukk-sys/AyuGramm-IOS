{
  "vgtheme": 1,
  "id": "nord",
  "name": "Nord",
  "author": "VoidGram",
  "description": "Arctic, north-bluish palette after nordtheme.com.",
  "base": "night",
  "accent": "$frost",
  "vars": {
    "polar0": "#2E3440",
    "polar1": "#3B4252",
    "polar2": "#434C5E",
    "polar3": "#4C566A",
    "snow": "#ECEFF4",
    "snow2": "#D8DEE9",
    "frost": "#88C0D0",
    "frost2": "#5E81AC",
    "aurora": "#BF616A"
  },
  "colors": {
    "background": "$polar0",
    "surface": "$polar1",
    "separator": "$polar2",
    "text": "$snow",
    "secondaryText": "mix($snow2, $polar3, 0.35)",
    "destructive": "$aurora",
    "highlight": "$polar2",
    "switch.on": "$frost",
    "navBar.background": "alpha($polar0, 0.94)",
    "tabBar.background": "alpha($polar0, 0.94)",
    "tabBar.selected": "$frost",
    "badge.background": "$frost2",
    "search.background": "$polar1",
    "chatList.pinned": "mix($polar0, $polar1, 0.5)",
    "chatList.muted": "$polar3",
    "outgoing.bubble": "$frost2",
    "outgoing.text": "$snow",
    "outgoing.secondaryText": "alpha($snow, 0.7)",
    "outgoing.link": "#E5F0F7",
    "outgoing.accent": "#E5F0F7",
    "outgoing.check": "#E5F0F7",
    "incoming.bubble": "$polar1",
    "incoming.text": "$snow",
    "incoming.secondaryText": "$snow2",
    "incoming.link": "$frost",
    "incoming.accent": "$frost",
    "input.background": "alpha($polar0, 0.95)",
    "input.field": "$polar1",
    "input.accent": "$frost",
    "input.sendIcon": "$polar0"
  },
  "wallpaper": { "colors": ["#2E3440", "#3B4252"], "rotation": 45 }
}
