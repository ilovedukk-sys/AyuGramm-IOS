{
  "format": "ayu-theme-1",
  "id": "glass_mono",
  "name": "Glass Mono",
  "author": "AyuGram",
  "version": "1.0",
  "description": "Обычные формы и стекло Telegram, но чёрно-белые цвета и шрифт Golos.",
