new file mode 100644
index 0000000..1240c70
--- /dev/null
+++ b/submodules/AyuLiveActivityAttributes/Sources/AyuActivityAttributes.swift
@@ -0,0 +1,46 @@
+import Foundation
+import ActivityKit
+
+// Shared by the app, which starts Live Activities, and the widget extension, which draws them.
+
+public enum AyuActivityKind: String, Codable, Hashable {
+    case download
+    case upload
+    case call
+    case groupCall
+    case location
+}
+
+public struct AyuActivityContentState: Codable, Hashable {
+    public var title: String
+    public var subtitle: String
+    /// 0...1 for a transfer, nil when the activity has no progress.
+    public var progress: Double?
+    /// The moment a call began: the activity counts up from it without further updates.
+    public var timerStart: Date?
+    /// The moment sharing ends: the activity counts down to it without further updates.
+    public var timerEnd: Date?
+    public var isMuted: Bool
+    public var isFinished: Bool
+
+    public init(title: String, subtitle: String, progress: Double? = nil, timerStart: Date? = nil, timerEnd: Date? = nil, isMuted: Bool = false, isFinished: Bool = false) {
+        self.title = title
+        self.subtitle = subtitle
+        self.progress = progress
+        self.timerStart = timerStart
+        self.timerEnd = timerEnd
+        self.isMuted = isMuted
+        self.isFinished = isFinished
+    }
+}
+
+@available(iOS 16.1, *)
+public struct AyuActivityAttributes: ActivityAttributes {
+    public typealias ContentState = AyuActivityContentState
+
+    public let kind: AyuActivityKind
+
+    public init(kind: AyuActivityKind) {
+        self.kind = kind
+    }
+}
