+// Pixel style: the layer jumps through a few values and never overshoots. Nil keeps the regular animation.
+private func ayuSteppedAnimation(layer: CALayer, from: Any?, to: Any, keyPath: String, isLinear: Bool, duration: Double, delay: Double, removeOnCompletion: Bool, additive: Bool, completion: ((Bool) -> Void)?) -> CAAnimation? {
+    guard AyuPixelStyle.isEnabled, keyPath != "cornerRadius", duration > 0.0, duration <= 0.7, let from else {
+        return nil
+    }
+    let steps = max(2, min(8, Int((duration * 20.0).rounded())))
+    var values: [AnyObject] = []
+    var keyTimes: [NSNumber] = [0.0]
