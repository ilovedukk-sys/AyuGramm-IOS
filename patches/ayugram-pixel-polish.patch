+private let ayuTransformType = String(cString: NSValue(caTransform3D: CATransform3DIdentity).objCType)
+
+private func ayuMix(_ from: CGFloat, _ to: CGFloat, _ fraction: CGFloat) -> CGFloat {
+    return from + (to - from) * fraction
+}
+
+private func ayuInterpolatedValue(from: Any, to: Any, fraction: CGFloat) -> AnyObject? {
+    if let from = from as? NSNumber, let to = to as? NSNumber {
+        return NSNumber(value: from.doubleValue + (to.doubleValue - from.doubleValue) * Double(fraction))
+    }
+    guard let from = from as? NSValue, let to = to as? NSValue else {
+        return nil
+    }
+    let type = String(cString: from.objCType)
+    if type != String(cString: to.objCType) {
+        return nil
+    }
+    if type == ayuPointType {
+        let a = from.cgPointValue
+        let b = to.cgPointValue
+        return NSValue(cgPoint: CGPoint(x: ayuMix(a.x, b.x, fraction), y: ayuMix(a.y, b.y, fraction)))
+    } else if type == ayuSizeType {
+        let a = from.cgSizeValue
+        let b = to.cgSizeValue
+        return NSValue(cgSize: CGSize(width: ayuMix(a.width, b.width, fraction), height: ayuMix(a.height, b.height, fraction)))
+    } else if type == ayuRectType {
+        let a = from.cgRectValue
+        let b = to.cgRectValue
+        return NSValue(cgRect: CGRect(x: ayuMix(a.minX, b.minX, fraction), y: ayuMix(a.minY, b.minY, fraction), width: ayuMix(a.width, b.width, fraction), height: ayuMix(a.height, b.height, fraction)))
+    } else if type == ayuTransformType {
+        let a = from.caTransform3DValue
+        let b = to.caTransform3DValue
+        var result = CATransform3DIdentity
+        result.m11 = ayuMix(a.m11, b.m11, fraction)
+        result.m12 = ayuMix(a.m12, b.m12, fraction)
+        result.m13 = ayuMix(a.m13, b.m13, fraction)
+        result.m14 = ayuMix(a.m14, b.m14, fraction)
+        result.m21 = ayuMix(a.m21, b.m21, fraction)
+        result.m22 = ayuMix(a.m22, b.m22, fraction)
+        result.m23 = ayuMix(a.m23, b.m23, fraction)
+        result.m24 = ayuMix(a.m24, b.m24, fraction)
+        result.m31 = ayuMix(a.m31, b.m31, fraction)
+        result.m32 = ayuMix(a.m32, b.m32, fraction)
+        result.m33 = ayuMix(a.m33, b.m33, fraction)
+        result.m34 = ayuMix(a.m34, b.m34, fraction)
+        result.m41 = ayuMix(a.m41, b.m41, fraction)
+        result.m42 = ayuMix(a.m42, b.m42, fraction)
+        result.m43 = ayuMix(a.m43, b.m43, fraction)
