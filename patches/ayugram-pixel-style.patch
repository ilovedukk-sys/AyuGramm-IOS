@@ -0,0 +1,20 @@
+import Foundation
+
+// Monochrome pixel look. Every change of the style checks this one switch.
+public enum AyuPixelStyle {
+    public static var isEnabled: Bool {
+        return true
+    }
+
+    // Rec. 709 luma; the alpha byte of an ARGB value is kept.
+    public static func monochrome(_ value: UInt32) -> UInt32 {
+        guard self.isEnabled else {
+            return value
+        }
+        let red = (value >> 16) & 0xff
+        let green = (value >> 8) & 0xff
+        let blue = value & 0xff
+        let luma = (red * 2126 + green * 7152 + blue * 722 + 5000) / 10000
+        return (value & 0xff000000) | (luma << 16) | (luma << 8) | luma
+    }
+}
