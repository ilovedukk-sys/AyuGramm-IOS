+    private static let aliasNames = Set(AyuThemeEngine.aliases.map { $0.0 })
+
+    /// A name left out of the file takes this expression of another one, when that one is set.
+    static let derived: [(String, String, String)] = [
+        ("outgoing.bubbleHighlighted", "outgoing.bubble", "darken({}, 0.08)"),
+        ("incoming.bubbleHighlighted", "incoming.bubble", "darken({}, 0.08)")
+    ]
+
+    public struct ThemeError: Error, CustomStringConvertible {
+        public let description: String
+        init(_ description: String) {
+            self.description = description
+        }
+    }
+
+    public struct Theme {
+        public let id: String
+        public let names: [String: String]
+        public let author: String
+        public let summary: String
+        public let base: String
+        public let document: [String: Any]
+        /// The file as installed (or the built-in text), for sharing.
+        public let data: Data
+        public let isBuiltin: Bool
+
+        public func name(russian: Bool) -> String {
+            return self.names[russian ? "ru" : "en"] ?? self.names["en"] ?? self.names.values.sorted().first ?? self.id
+        }
+    }
+
+    public struct Resolved {
+        public let base: String
+        public let accent: UInt32?
+        /// Native key -> ARGB.
+        public let native: [String: UInt32]
+        /// ARGB, 0 to 4 colours.
+        public let wallpaper: [UInt32]
+        public let rotation: Int32
+        public let warnings: [String]
+    }
+
+    // MARK: Reading a file
+
+    private static func isBoolean(_ value: Any?) -> Bool {
+        guard let number = value as? NSNumber else { return false }
+        return CFGetTypeID(number) == CFBooleanGetTypeID()
+    }
+
+    private static func object(_ source: [String: Any], _ name: String, _ location: String) throws -> [String: Any] {
+        guard let value = source[name] else { return [:] }
+        guard let dictionary = value as? [String: Any] else {
+            throw ThemeError("\(location)\(name) must be an object")
+        }
+        return dictionary
+    }
+
+    private static func matches(_ text: String, _ pattern: String) -> Bool {
+        return text.range(of: pattern, options: .regularExpression) != nil
+    }
+
+    /// Reads and checks a theme without resolving it; `resolve` reports colour errors.
+    public static func parse(_ data: Data, builtin: Bool = false) throws -> Theme {
+        guard data.count <= AyuThemeEngine.maxFileBytes else {
+            throw ThemeError("larger than \(AyuThemeEngine.maxFileBytes / 1024) KB")
+        }
+        var bytes = data
+        if bytes.starts(with: [0xEF, 0xBB, 0xBF]) {
+            bytes = bytes.dropFirst(3)
+        }
+        guard let json = try? JSONSerialization.jsonObject(with: bytes, options: []) else {
+            throw ThemeError("not valid JSON")
+        }
+        guard let document = json as? [String: Any] else {
+            throw ThemeError("a theme is a JSON object")
+        }
+        guard let version = document["vgtheme"] as? NSNumber, !isBoolean(version), version.doubleValue == Double(AyuThemeEngine.formatVersion) else {
+            throw ThemeError("\"vgtheme\" must be \(AyuThemeEngine.formatVersion)")
+        }
+        guard let id = document["id"] as? String, matches(id, "^[a-z0-9][a-z0-9._-]{0,63}$") else {
+            throw ThemeError("\"id\" must be 1–64 of a-z 0-9 . _ - starting with a letter or digit")
+        }
+        var names: [String: String] = [:]
+        if let name = document["name"] as? String, !name.trimmingCharacters(in: .whitespaces).isEmpty {
+            names["en"] = name
+        } else if let localized = document["name"] as? [String: Any], !localized.isEmpty {
+            for (language, value) in localized {
+                guard let text = value as? String, !text.trimmingCharacters(in: .whitespaces).isEmpty else {
+                    throw ThemeError("\"name\" must be a string or {\"en\": …, \"ru\": …}")
+                }
+                names[language] = text
+            }
+        } else {
+            throw ThemeError("\"name\" must be a string or {\"en\": …, \"ru\": …}")
+        }
+        let base = document["base"] ?? "inherit"
+        guard let baseName = base as? String, AyuThemeEngine.bases.contains(baseName) else {
+            throw ThemeError("\"base\" must be one of " + AyuThemeEngine.bases.joined(separator: ", "))
+        }
+        for field in ["author", "description"] {
+            if let value = document[field], !(value is String) {
+                throw ThemeError("\"\(field)\" must be a string")
+            }
+        }
+        let variants = try object(document, "variants", "")
+        for variant in variants.keys where variant != "light" && variant != "dark" {
+            throw ThemeError("variants may only be \"light\" and \"dark\", not \"\(variant)\"")
+        }
+        var blocks: [(String, [String: Any])] = [("", document)]
+        for (name, value) in variants {
+            guard let block = value as? [String: Any] else {
+                throw ThemeError("variants.\(name) must be an object")
+            }
+            blocks.append(("variants.\(name).", block))
+        }
+        for (location, block) in blocks {
+            let variables = try object(block, "vars", location)
+            guard variables.count <= AyuThemeEngine.maxVars else {
+                throw ThemeError("\(location)vars: at most \(AyuThemeEngine.maxVars)")
+            }
+            for name in variables.keys where !matches(name, "^[A-Za-z_][A-Za-z0-9_-]{0,47}$") {
+                throw ThemeError("\(location)vars: '\(name)' is not a valid name")
+            }
+            for name in try object(block, "colors", location).keys where !aliasNames.contains(name) {
+                throw ThemeError("\(location)colors: unknown name '\(name)'")
+            }
+            guard try object(block, "native", location).count <= AyuThemeEngine.maxNative else {
+                throw ThemeError("\(location)native: at most \(AyuThemeEngine.maxNative) keys")
+            }
+        }
+        return Theme(id: id, names: names, author: document["author"] as? String ?? "", summary: document["description"] as? String ?? "", base: baseName, document: document, data: data, isBuiltin: builtin)
+    }
+
+    // MARK: Colours
+
+    static func parseHex(_ text: String) -> UInt32? {
+        if text == "transparent" {
+            return 0
+        }
+        guard text.hasPrefix("#") else { return nil }
+        var digits = String(text.dropFirst())
+        guard [3, 4, 6, 8].contains(digits.count), digits.allSatisfy({ $0.isHexDigit && $0.isASCII }) else {
+            return nil
+        }
+        if digits.count <= 4 {
+            digits = digits.map { "\($0)\($0)" }.joined()
+        }
+        let rgb = String(digits.prefix(6))
+        let alpha = digits.count == 8 ? String(digits.suffix(2)) : "ff"
+        guard let rgbValue = UInt32(rgb, radix: 16), let alphaValue = UInt32(alpha, radix: 16) else {
+            return nil
+        }
+        return (alphaValue << 24) | rgbValue
+    }
+
+    private static func lerp(_ x: UInt32, _ y: UInt32, _ t: Double) -> UInt32 {
+        let value = floor(Double(x) + (Double(y) - Double(x)) * t + 0.5)
+        return UInt32(max(0.0, min(255.0, value)))
+    }
+
+    static func mix(_ first: UInt32, _ second: UInt32, _ t: Double) -> UInt32 {
+        var result: UInt32 = 0
+        for shift: UInt32 in [24, 16, 8, 0] {
+            result |= lerp((first >> shift) & 0xFF, (second >> shift) & 0xFF, t) << shift
+        }
+        return result
+    }
+
+    static func contrast(_ color: UInt32) -> UInt32 {
+        let r = (color >> 16) & 0xFF, g = (color >> 8) & 0xFF, b = color & 0xFF
+        return (299 * r + 587 * g + 114 * b) / 1000 > 150 ? 0xFF000000 : 0xFFFFFFFF
+    }
+
+    public static func hexString(_ argb: UInt32) -> String {
+        let alpha = (argb >> 24) & 0xFF
+        let rgb = String(format: "#%06X", argb & 0xFFFFFF)
+        return alpha == 255 ? rgb : rgb + String(format: "%02X", alpha)
+    }
+
+    // MARK: Expressions
+
+    private final class Context {
+        let variables: [String: Any]
+        let base: (String) -> UInt32?
+        let knownKey: (String) -> Bool
+        var resolving: [String] = []
+        var cache: [String: UInt32] = [:]
+        var warnings: [String] = []
+
+        init(variables: [String: Any], base: @escaping (String) -> UInt32?, knownKey: @escaping (String) -> Bool) {
+            self.variables = variables
+            self.base = base
+            self.knownKey = knownKey
+        }
+    }
+
+    /// expr := #hex | transparent | $var | @native.key | name(arg, ...); arg := expr | number[%]
+    private struct Parser {
+        static let functions: Set<String> = ["mix", "alpha", "lighten", "darken", "contrast"]
+
+        let text: String
+        let characters: [Character]
+        var index = 0
+        let context: Context
+        var depth: Int
+
+        init(_ text: String, context: Context, depth: Int) {
+            self.text = text
+            self.characters = Array(text)
+            self.context = context
+            self.depth = depth
+        }
+
+        func fail(_ message: String) -> ThemeError {
+            return ThemeError("\(message) in '\(self.text)'")
+        }
+
+        mutating func skip() {
+            while self.index < self.characters.count && self.characters[self.index] == " " {
+                self.index += 1
+            }
+        }
+
+        static func isWordCharacter(_ c: Character) -> Bool {
+            return c.isASCII && (c.isLetter || c.isNumber || c == "_" || c == "." || c == "%" || c == "-")
+        }
+
+        mutating func token() throws -> String {
+            self.skip()
+            let start = self.index
+            if self.index < self.characters.count && "#$@".contains(self.characters[self.index]) {
+                self.index += 1
+            }
+            let wordStart = self.index
+            while self.index < self.characters.count && Parser.isWordCharacter(self.characters[self.index]) {
+                self.index += 1
+            }
+            guard self.index > wordStart else {
+                self.index = start
+                throw self.fail("expected a value")
+            }
+            return String(self.characters[start ..< self.index])
+        }
+
+        mutating func number() throws -> Double {
+            let word = try self.token()
+            guard AyuThemeEngine.matches(word, "^[0-9]*\\.?[0-9]+%?$") else {
+                throw self.fail("'\(word)' is not a number")
+            }
+            let value = word.hasSuffix("%") ? Double(word.dropLast())! / 100.0 : Double(word)!
+            guard value >= 0.0 && value <= 1.0 else {
+                throw self.fail("\(word) is outside 0…1")
+            }
+            return value
+        }
+
+        mutating func expect(_ char: Character) throws {
+            self.skip()
+            guard self.index < self.characters.count && self.characters[self.index] == char else {
+                throw self.fail("expected '\(char)'")
+            }
+            self.index += 1
+        }
+
+        mutating func nested() throws -> UInt32 {
+            self.depth += 1
+            defer { self.depth -= 1 }
+            return try self.color()
+        }
+
+        mutating func color() throws -> UInt32 {
+            guard self.depth <= AyuThemeEngine.maxDepth else {
+                throw self.fail("too deeply nested")
+            }
+            let word = try self.token()
+            if word.hasPrefix("$") {
+                return try AyuThemeEngine.resolveVariable(String(word.dropFirst()), self.context, self.depth + 1)
+            }
+            if word.hasPrefix("@") {
+                let path = String(word.dropFirst())
+                guard self.context.knownKey(path) else {
+                    throw self.fail("unknown native key '\(path)'")
+                }
+                if let value = self.context.base(path) {
+                    return value
+                }
+                self.context.warnings.append("@\(path) has no base value here; grey used")
+                return 0xFF808080
+            }
+            if word.hasPrefix("#") || word == "transparent" {
+                guard let value = AyuThemeEngine.parseHex(word) else {
+                    throw self.fail("'\(word)' is not a colour")
+                }
+                return value
+            }
+            guard Parser.functions.contains(word) else {
+                throw self.fail("unknown function '\(word)'")
+            }
+            try self.expect("(")
+            let result: UInt32
+            switch word {
+            case "contrast":
+                result = AyuThemeEngine.contrast(try self.nested())
+            case "mix":
+                let first = try self.nested()
+                try self.expect(",")
+                let second = try self.nested()
+                try self.expect(",")
+                result = AyuThemeEngine.mix(first, second, try self.number())
+            default:
+                let base = try self.nested()
+                try self.expect(",")
+                let amount = try self.number()
+                if word == "alpha" {
+                    result = (base & 0x00FFFFFF) | (AyuThemeEngine.lerp(0, 255, amount) << 24)
+                } else {
+                    let target: UInt32 = word == "lighten" ? 0xFFFFFF : 0x000000
+                    result = AyuThemeEngine.mix(base, (base & 0xFF000000) | target, amount)
+                }
+            }
+            try self.expect(")")
+            return result
+        }
+
+        mutating func parse() throws -> UInt32 {
+            let value = try self.color()
+            self.skip()
+            guard self.index == self.characters.count else {
+                throw self.fail("unexpected text at the end")
+            }
+            return value
+        }
+    }
+
+    private static func evaluate(_ value: Any, _ context: Context, _ depth: Int = 0) throws -> UInt32 {
+        guard let raw = value as? String else {
+            throw ThemeError("colour must be a string")
+        }
+        let text = raw.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !text.isEmpty && text.count <= AyuThemeEngine.maxExpression else {
+            throw ThemeError("colour expression must be 1…\(AyuThemeEngine.maxExpression) characters")
+        }
+        var parser = Parser(text, context: context, depth: depth)
+        return try parser.parse()
+    }
+
+    private static func resolveVariable(_ name: String, _ context: Context, _ depth: Int) throws -> UInt32 {
+        if let cached = context.cache[name] {
+            return cached
+        }
+        guard let expression = context.variables[name] else {
+            throw ThemeError("unknown variable $\(name)")
+        }
+        guard !context.resolving.contains(name) else {
+            throw ThemeError("variable cycle: " + (context.resolving + [name]).map { "$" + $0 }.joined(separator: " -> "))
+        }
+        context.resolving.append(name)
+        defer { context.resolving.removeLast() }
+        let value = try evaluate(expression, context, depth)
+        context.cache[name] = value
+        return value
+    }
+
+    /// The document with variants.light or variants.dark laid over it.
+    private static func mergedBlock(_ document: [String: Any], dark: Bool) throws -> [String: Any] {
+        let variant = try object(document, "variants", "")[dark ? "dark" : "light"] as? [String: Any] ?? [:]
+        var result: [String: Any] = [:]
+        for name in ["vars", "colors", "native"] {
+            result[name] = try object(document, name, "").merging(try object(variant, name, ""), uniquingKeysWith: { _, new in new })
+        }
+        for name in ["accent", "wallpaper"] {
+            if let value = variant[name] ?? document[name] {
+                result[name] = value
+            }
+        }
+        return result
+    }
+
+    /// Colours for the light or dark look. `base` answers `@key` with the theme underneath;
+    /// `knownKey` tells native keys the app knows from typos.
+    public static func resolve(_ theme: Theme, dark: Bool, base: @escaping (String) -> UInt32? = { _ in nil }, knownKey: @escaping (String) -> Bool = { _ in true }) throws -> Resolved {
+        let block = try mergedBlock(theme.document, dark: dark)
+        let variables = block["vars"] as? [String: Any] ?? [:]
+        let context = Context(variables: variables, base: base, knownKey: knownKey)
+        func value(_ expression: Any, _ location: String) throws -> UInt32 {
+            do {
+                return try evaluate(expression, context)
+            } catch let error as ThemeError {
+                throw ThemeError("\(location): \(error.description)")
+            }
+        }
+        let accent = try block["accent"].map { try value($0, "accent") }
+        var colors = block["colors"] as? [String: Any] ?? [:]
+        for (target, source, template) in AyuThemeEngine.derived where colors[target] == nil {
+            if let expression = colors[source] as? String {
+                colors[target] = template.replacingOccurrences(of: "{}", with: expression)
+            }
+        }
+        var native: [String: UInt32] = [:]
+        for (name, targets) in AyuThemeEngine.aliases {
+            guard let expression = colors[name] else { continue }
+            let resolved = try value(expression, "colors.\(name)")
+            for target in targets {
+                native[target] = resolved
+            }
+        }
+        for (path, expression) in block["native"] as? [String: Any] ?? [:] {
+            guard knownKey(path) else {
+                context.warnings.append("native.\(path) is not a Telegram theme key; ignored")
+                continue
+            }
+            native[path] = try value(expression, "native.\(path)")
+        }
+        var wallpaper: [UInt32] = []
+        var rotation: Int32 = 0
+        if let spec = block["wallpaper"] {
+            var colorList: [Any]?
+            var rotationValue: Any?
+            if let single = spec as? String {
+                colorList = [single]
+            } else if let list = spec as? [Any] {
+                colorList = list
+            } else if let dictionary = spec as? [String: Any] {
+                colorList = dictionary["colors"] as? [Any]
+                rotationValue = dictionary["rotation"]
+            }
+            guard let entries = colorList, (1 ... 4).contains(entries.count) else {
+                throw ThemeError("wallpaper must be a colour, a list of 1–4 colours or {colors, rotation}")
+            }
+            for (index, color) in entries.enumerated() {
+                wallpaper.append(try value(color, "wallpaper[\(index)]") | 0xFF000000)
+            }
+            if let rotationValue {
+                guard let number = rotationValue as? NSNumber, !isBoolean(number), number.doubleValue == Double(number.intValue), (0 ..< 360).contains(number.intValue) else {
+                    throw ThemeError("wallpaper.rotation must be a whole number 0…359")
+                }
+                rotation = Int32(number.intValue)
+            }
+        }
+        for name in variables.keys.sorted() {
+            do {
+                _ = try resolveVariable(name, context, 0)
+            } catch let error as ThemeError {
+                throw ThemeError("vars.\(name): \(error.description)")
+            }
+        }
+        var seen = Set<String>()
+        let warnings = context.warnings.filter { seen.insert($0).inserted }
+        return Resolved(base: theme.base, accent: accent, native: native, wallpaper: wallpaper, rotation: rotation, warnings: warnings)
+    }
+
+    /// Parses and resolves both looks; what an import shows before installing. `knownKey` flags
+    /// native keys the current Telegram theme does not have.
+    public static func check(_ data: Data, knownKey: @escaping (String) -> Bool = { _ in true }) throws -> (Theme, [String]) {
+        let theme = try parse(data)
+        let light = try resolve(theme, dark: false, knownKey: knownKey)
+        let dark = try resolve(theme, dark: true, knownKey: knownKey)
+        var seen = Set<String>()
+        return (theme, (light.warnings + dark.warnings).filter { seen.insert($0).inserted })
+    }
+
+    // MARK: Installed themes
+
+    private static let activeKey = "ayu.theme.active"
+    private static let lock = NSLock()
+    private static var cachedActive: (id: String, theme: Theme?)?
+
+    /// Bumped on every change so presentation themes are rebuilt.
+    public private(set) static var revision: Int = 0
+
+    public static var directory: URL {
+        let support = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first ?? URL(fileURLWithPath: NSTemporaryDirectory())
+        return support.appendingPathComponent("VoidGram/Themes", isDirectory: true)
+    }
+
+    private static func fileURL(id: String) -> URL {
+        return AyuThemeEngine.directory.appendingPathComponent(id + "." + AyuThemeEngine.fileExtension)
+    }
+
+    public static let builtins: [Theme] = AyuThemeEngineBuiltins.all.compactMap { try? AyuThemeEngine.parse(Data($0.utf8), builtin: true) }
+
+    /// Built-in themes first, then the user's by name.
+    public static var installed: [Theme] {
+        let files = (try? FileManager.default.contentsOfDirectory(at: AyuThemeEngine.directory, includingPropertiesForKeys: nil)) ?? []
+        let user = files.filter { $0.pathExtension == AyuThemeEngine.fileExtension }.compactMap { url -> Theme? in
+            return (try? Data(contentsOf: url)).flatMap { try? AyuThemeEngine.parse($0) }
+        }.sorted { $0.name(russian: false).localizedCaseInsensitiveCompare($1.name(russian: false)) == .orderedAscending }
+        let builtinIds = Set(AyuThemeEngine.builtins.map { $0.id })
+        return AyuThemeEngine.builtins + user.filter { !builtinIds.contains($0.id) }
+    }
+
+    public static func theme(id: String) -> Theme? {
+        if let builtin = AyuThemeEngine.builtins.first(where: { $0.id == id }) {
+            return builtin
+        }
+        return (try? Data(contentsOf: AyuThemeEngine.fileURL(id: id))).flatMap { try? AyuThemeEngine.parse($0) }
+    }
+
+    public static var activeId: String? {
+        let value = UserDefaults.standard.string(forKey: AyuThemeEngine.activeKey) ?? ""
+        return value.isEmpty ? nil : value
+    }
+
+    /// The theme in use, nil for Telegram's own; decoy mode hides it like every VoidGram look.
+    public static var active: Theme? {
+        guard !AyuDecoyMode.isActive, let id = AyuThemeEngine.activeId else {
+            return nil
+        }
+        AyuThemeEngine.lock.lock()
+        defer { AyuThemeEngine.lock.unlock() }
+        if let cached = AyuThemeEngine.cachedActive, cached.id == id {
+            return cached.theme
+        }
+        let theme = AyuThemeEngine.theme(id: id)
+        AyuThemeEngine.cachedActive = (id, theme)
+        return theme
+    }
+
+    public static var isActive: Bool {
+        return AyuThemeEngine.active != nil
+    }
+
+    public static func activate(_ id: String?) {
+        if let id {
+            UserDefaults.standard.set(id, forKey: AyuThemeEngine.activeKey)
+        } else {
+            UserDefaults.standard.removeObject(forKey: AyuThemeEngine.activeKey)
+        }
+        AyuThemeEngine.changed()
+    }
+
+    /// Checks and saves a theme file; one with the id of an installed theme replaces it.
+    @discardableResult
+    public static func install(_ data: Data) throws -> Theme {
+        let (theme, _) = try AyuThemeEngine.check(data)
+        if AyuThemeEngine.builtins.contains(where: { $0.id == theme.id }) {
+            throw ThemeError("\"\(theme.id)\" is the id of a built-in theme; give the copy another id")
+        }
+        try FileManager.default.createDirectory(at: AyuThemeEngine.directory, withIntermediateDirectories: true)
+        try data.write(to: AyuThemeEngine.fileURL(id: theme.id), options: .atomic)
+        AyuThemeEngine.changed()
+        return theme
+    }
+
+    public static func delete(id: String) {
+        try? FileManager.default.removeItem(at: AyuThemeEngine.fileURL(id: id))
+        if AyuThemeEngine.activeId == id {
+            UserDefaults.standard.removeObject(forKey: AyuThemeEngine.activeKey)
+        }
+        AyuThemeEngine.changed()
+    }
+
+    /// A file to share: the installed one, or a temporary copy of a built-in theme.
+    public static func shareURL(_ theme: Theme) -> URL? {
+        let url = FileManager.default.temporaryDirectory.appendingPathComponent(theme.id + "." + AyuThemeEngine.fileExtension)
+        do {
+            try theme.data.write(to: url, options: .atomic)
+            return url
+        } catch {
+            return nil
+        }
+    }
+
+    /// The active theme resolved for one look. Errors leave Telegram's look.
+    public static func resolvedActive(dark: Bool, base: @escaping (String) -> UInt32?, knownKey: @escaping (String) -> Bool) -> Resolved? {
+        guard let theme = AyuThemeEngine.active else {
+            return nil
+        }
+        return try? AyuThemeEngine.resolve(theme, dark: dark, base: base, knownKey: knownKey)
+    }
+
+    private static func changed() {
+        AyuThemeEngine.lock.lock()
+        AyuThemeEngine.cachedActive = nil
+        AyuThemeEngine.revision += 1
+        AyuThemeEngine.lock.unlock()
+        NotificationCenter.default.post(name: AyuThemeEngine.didChangeNotification, object: nil)
+    }
+
+    // MARK: Writing themes
+
+    /// A theme file from the Customization colours, so they can be shared or kept.
+    public static func documentFromCustomization(id: String, name: String) -> Data? {
+        let mapping: [(AyuCustomization.Color, String)] = [
+            (.outgoingBubble, "outgoing.bubble"), (.outgoingText, "outgoing.text"),
+            (.incomingBubble, "incoming.bubble"), (.incomingText, "incoming.text"),
+            (.listBackground, "background"), (.chatTitle, "chatList.title")
+        ]
+        var document: [String: Any] = ["vgtheme": AyuThemeEngine.formatVersion, "id": id, "name": name, "author": "VoidGram"]
+        var colors: [String: String] = [:]
+        for (color, alias) in mapping {
+            if let hex = AyuCustomization.hex(color) {
+                colors[alias] = hex
+            }
+        }
+        if !colors.isEmpty {
+            document["colors"] = colors
+        }
+        if let accent = AyuCustomization.hex(.accent) {
+            document["accent"] = accent
+        }
+        if let first = AyuCustomization.hex(.wallpaper) {
+            document["wallpaper"] = [first] + (AyuCustomization.hex(.wallpaperSecond).map { [$0] } ?? [])
+        }
+        return try? JSONSerialization.data(withJSONObject: document, options: [.prettyPrinted, .sortedKeys])
+    }
+}
