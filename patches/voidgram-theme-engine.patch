index 0000000000..266eb334cf
--- /dev/null
+++ b/submodules/TelegramPresentationData/Sources/AyuThemeEngineApply.swift
@@ -0,0 +1,280 @@
+import Foundation
+import UIKit
+import Display
+import TelegramCore
+import TelegramUIPreferences
+
+// VoidGram theme engine, second half: lays a resolved .vgtheme over a PresentationTheme.
+// The theme goes through Telegram's own theme text (the .tgios-theme format that
+// encodePresentationTheme writes and makePresentationTheme reads), so a theme can set any of
+// Telegram's keys without a hand-written mapping per colour.
+
+/// Telegram's theme text as a tree: "key: value" lines, two spaces per level.
+final class AyuThemeTree {
+    final class Node {
+        var value: String?
+        var children: [(key: String, node: Node)] = []
+
+        init(value: String? = nil) {
+            self.value = value
+        }
+
+        func child(_ key: String) -> Node? {
+            return self.children.first(where: { $0.key == key })?.node
+        }
+    }
+
+    let root = Node()
+
+    /// Reads the text the way makePresentationTheme does.
+    init?(text: String) {
+        var stack: [Node] = [self.root]
+        for line in text.split(whereSeparator: { $0.isNewline }) {
+            let trimmed = line.trimmingCharacters(in: .whitespaces)
+            if trimmed.hasPrefix("#") || trimmed.hasPrefix("//") {
+                continue
+            }
+            guard let colon = line.firstIndex(of: ":") else { continue }
+            let key = line[line.startIndex ..< colon]
+            let spaces = key.prefix(while: { $0 == " " }).count
+            guard spaces % 2 == 0, spaces / 2 < stack.count else {
+                return nil
+            }
+            stack.removeLast(stack.count - spaces / 2 - 1)
+            let value = line[line.index(after: colon)...].trimmingCharacters(in: .whitespacesAndNewlines)
+            let node = Node(value: value.isEmpty ? nil : value)
+            stack[stack.count - 1].children.append((key.trimmingCharacters(in: .whitespaces), node))
+            if value.isEmpty {
+                stack.append(node)
+            }
+        }
+    }
+
+    private func node(_ components: [String]) -> Node? {
+        var current = self.root
+        for component in components {
+            guard let next = current.child(component) else { return nil }
+            current = next
+        }
+        return current
+    }
+
+    func value(_ path: String) -> String? {
+        return self.node(path.components(separatedBy: "."))?.value
+    }
+
+    func contains(_ path: String) -> Bool {
+        return self.node(path.components(separatedBy: ".")) != nil
+    }
+
+    /// Sets a leaf. Its parent must exist; a missing leaf is added, since some colours are optional
+    /// and fall back to another key when absent.
+    @discardableResult
+    func set(_ path: String, _ value: String) -> Bool {
+        var components = path.components(separatedBy: ".")
+        let leaf = components.removeLast()
+        guard let parent = self.node(components), parent.value == nil else {
+            return false
+        }
+        if let existing = parent.child(leaf) {
+            guard existing.children.isEmpty else { return false }
+            existing.value = value
+        } else {
+            parent.children.append((leaf, Node(value: value)))
+        }
+        // A bubble with three or more colours stores them in `bgList`, which the decoder prefers
+        // over `bg`; a single new fill replaces the list.
+        if leaf == "bg" || leaf == "gradientBg", parent.child("bgList") != nil {
+            parent.children.removeAll(where: { $0.key == "bgList" })
+            if parent.child("gradientBg") == nil {
+                parent.children.append(("gradientBg", Node(value: value)))
+            }
+            if parent.child("bg") == nil {
+                parent.children.append(("bg", Node(value: value)))
+            }
+        }
+        return true
+    }
+
+    var text: String {
+        var result = ""
+        func render(_ node: Node, level: Int) {
+            for (key, child) in node.children {
+                result.append(String(repeating: "  ", count: level))
+                if let value = child.value {
+                    result.append("\(key): \(value)\n")
+                } else {
+                    result.append("\(key):\n")
+                    render(child, level: level + 1)
+                }
+            }
+        }
+        render(self.root, level: 0)
+        return result
+    }
+
+    /// A colour in Telegram's notation: rrggbb, aarrggbb or clear.
+    static func colorValue(_ argb: UInt32) -> String {
+        if argb == 0 {
+            return "clear"
+        }
+        return (argb >> 24) == 0xFF ? String(format: "%06x", argb & 0xFFFFFF) : String(format: "%08x", argb)
+    }
+
+    /// ARGB of a colour leaf, for `@key` in theme files.
+    func color(_ path: String) -> UInt32? {
+        guard let value = self.value(path) else { return nil }
+        if value.lowercased() == "clear" {
+            return 0
+        }
+        guard let number = UInt32(value, radix: 16) else { return nil }
+        return value.count > 6 ? number : (0xFF000000 | number)
+    }
+}
+
+private func ayuThemeBase(_ base: String, current: PresentationTheme) -> PresentationTheme {
+    let reference: PresentationBuiltinThemeReference
+    switch base {
+    case "day":
+        reference = .day
+    case "classic":
+        reference = .dayClassic
+    case "night":
+        reference = .night
+    case "tinted":
+        reference = .nightAccent
+    default:
+        return current
+    }
+    if current.referenceTheme == reference {
+        return current
+    }
+    return makeDefaultPresentationTheme(reference: reference, serviceBackgroundColor: defaultServiceBackgroundColor, preview: current.preview)
+}
+
+private func ayuThemeTree(_ theme: PresentationTheme) -> AyuThemeTree? {
+    return encodePresentationTheme(theme).flatMap { AyuThemeTree(text: $0) }
+}
+
+/// The resolved active theme for the look of `theme` (light or dark), and the theme it goes on.
+private func ayuResolvedThemeEngine(_ theme: PresentationTheme) -> (resolved: AyuThemeEngine.Resolved, base: PresentationTheme)? {
+    guard let active = AyuThemeEngine.active else {
+        return nil
+    }
+    let base = ayuThemeBase(active.base, current: theme)
+    guard let tree = ayuThemeTree(base) else {
+        return nil
+    }
+    guard let resolved = AyuThemeEngine.resolvedActive(dark: base.overallDarkAppearance, base: { tree.color($0) }, knownKey: { tree.contains($0) || ayuThemeOptionalParent(tree, $0) }) else {
+        return nil
+    }
+    return (resolved, base)
+}
+
+/// An optional colour whose section exists (list.modalBlocksBg and the like).
+private func ayuThemeOptionalParent(_ tree: AyuThemeTree, _ path: String) -> Bool {
+    var components = path.components(separatedBy: ".")
+    guard components.count > 1 else { return false }
+    components.removeLast()
+    return tree.contains(components.joined(separator: ".")) && tree.value(components.joined(separator: ".")) == nil
+}
+
+/// The active .vgtheme over `theme`: base theme, accent, then every colour it sets.
+/// Telegram's look stays when no theme is active or the theme cannot be read.
+func ayuApplyThemeEngine(_ theme: PresentationTheme) -> PresentationTheme {
+    guard let engine = ayuResolvedThemeEngine(theme) else {
+        return theme
+    }
+    let resolved = engine.resolved
+    var result = engine.base
+    if let accent = resolved.accent {
+        result = customizePresentationTheme(result, editing: false, accentColor: UIColor(argb: accent), outgoingAccentColor: nil, backgroundColors: [], bubbleColors: [], animateBubbleColors: nil)
+    }
+    if resolved.native.isEmpty {
+        return result
+    }
+    guard let tree = ayuThemeTree(result) else {
+        return result
+    }
+    for (path, color) in resolved.native {
+        tree.set(path, AyuThemeTree.colorValue(color))
+    }
+    guard let decoded = makePresentationTheme(data: Data(tree.text.utf8)) else {
+        return result
+    }
+    // Keep the identity of the theme underneath: its name, index and reference drive caches and
+    // the theme picker's checkmark.
+    return PresentationTheme(name: result.name, index: result.index, referenceTheme: result.referenceTheme, overallDarkAppearance: result.overallDarkAppearance, intro: decoded.intro, passcode: decoded.passcode, rootController: decoded.rootController, list: decoded.list, chatList: decoded.chatList, chat: decoded.chat.withUpdated(defaultWallpaper: result.chat.defaultWallpaper), actionSheet: decoded.actionSheet, contextMenu: decoded.contextMenu, inAppNotification: decoded.inAppNotification, chart: decoded.chart, preview: result.preview)
+}
+
+/// The active theme's chat background for the look of `theme`: a colour or a 2–4 colour gradient.
+/// Cached per input theme and engine revision, since every PresentationData asks.
+func ayuThemeEngineWallpaper(_ theme: PresentationTheme) -> TelegramWallpaper? {
+    guard AyuThemeEngine.isActive else {
+        return nil
+    }
+    let revision = AyuThemeEngine.revision
+    ayuThemeWallpaperLock.lock()
+    defer { ayuThemeWallpaperLock.unlock() }
+    if let cached = ayuThemeWallpaperCache, cached.input === theme, cached.revision == revision {
+        return cached.wallpaper
+    }
+    var wallpaper: TelegramWallpaper?
+    if let resolved = ayuResolvedThemeEngine(theme)?.resolved, let first = resolved.wallpaper.first {
+        if resolved.wallpaper.count == 1 {
+            wallpaper = .color(first)
+        } else {
+            wallpaper = .gradient(TelegramWallpaper.Gradient(id: nil, colors: resolved.wallpaper, settings: WallpaperSettings(rotation: resolved.rotation)))
+        }
+    }
+    ayuThemeWallpaperCache = (theme, revision, wallpaper)
+    return wallpaper
+}
+
+private let ayuThemeWallpaperLock = NSLock()
+private var ayuThemeWallpaperCache: (input: PresentationTheme, revision: Int, wallpaper: TelegramWallpaper?)?
+
+/// Whether a native key exists in `theme` (or is an optional colour of an existing section), for
+/// the warnings of an import review.
+public func ayuThemeEngineKeyChecker(_ theme: PresentationTheme) -> (String) -> Bool {
+    guard let tree = ayuThemeTree(theme) else {
+        return { _ in true }
+    }
+    return { tree.contains($0) || ayuThemeOptionalParent(tree, $0) }
+}
+
+/// Every native key of `theme` with its colour, as a .vgtheme `native` block: a starting point
+/// for theme authors ("Export Telegram keys").
+public func ayuThemeEngineNativeDocument(_ theme: PresentationTheme, id: String, name: String) -> Data? {
+    guard let tree = ayuThemeTree(theme) else {
+        return nil
+    }
+    var native: [String: String] = [:]
+    func walk(_ node: AyuThemeTree.Node, _ prefix: String) {
+        for (key, child) in node.children {
+            let path = prefix.isEmpty ? key : prefix + "." + key
+            if child.value != nil, let color = tree.color(path) {
+                native[path] = AyuThemeEngine.hexString(color)
+            } else if child.value == nil {
+                walk(child, path)
+            }
+        }
+    }
+    walk(tree.root, "")
+    for meta in ["name", "basedOn", "dark", "chat.defaultWallpaper"] {
+        native[meta] = nil
+    }
+    let base: String
+    switch theme.referenceTheme {
+    case .day:
+        base = "day"
+    case .dayClassic:
+        base = "classic"
+    case .night:
+        base = "night"
+    case .nightAccent:
+        base = "tinted"
+    }
+    let document: [String: Any] = ["vgtheme": AyuThemeEngine.formatVersion, "id": id, "name": name, "author": "VoidGram", "base": base, "native": native]
+    return try? JSONSerialization.data(withJSONObject: document, options: [.prettyPrinted, .sortedKeys])
+}
