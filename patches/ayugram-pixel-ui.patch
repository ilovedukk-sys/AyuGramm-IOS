+// Redraws a small icon on a one point grid: coverage under the threshold is dropped,
+// everything else becomes solid gray. Large and stretchable images stay as they are.
+static UIImage *AyuPixelatedImage(UIImage *image) {
+    if (image == nil || image.images != nil || !UIEdgeInsetsEqualToEdgeInsets(image.capInsets, UIEdgeInsetsZero)) {
+        return image;
+    }
+    CGSize size = image.size;
+    CGFloat maxSide = MAX(size.width, size.height);
+    CGImageRef source = image.CGImage;
+    if (maxSide < 1.0 || maxSide > 64.0 || source == NULL) {
+        return image;
+    }
+    size_t gridWidth = MAX((size_t)1, (size_t)round(size.width));
+    size_t gridHeight = MAX((size_t)1, (size_t)round(size.height));
+    size_t fullWidth = CGImageGetWidth(source);
+    size_t fullHeight = CGImageGetHeight(source);
+    CGBitmapInfo bitmapInfo = (CGBitmapInfo)kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big;
+    CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
+
+    UIImage *result = image;
+    CGContextRef gridContext = CGBitmapContextCreate(NULL, gridWidth, gridHeight, 8, gridWidth * 4, colorSpace, bitmapInfo);
+    CGContextRef fullContext = CGBitmapContextCreate(NULL, fullWidth, fullHeight, 8, 0, colorSpace, bitmapInfo);
+    if (gridContext != NULL && fullContext != NULL) {
+        CGContextSetInterpolationQuality(gridContext, kCGInterpolationHigh);
+        CGContextDrawImage(gridContext, CGRectMake(0.0, 0.0, (CGFloat)gridWidth, (CGFloat)gridHeight), source);
+
+        uint8_t *pixels = (uint8_t *)CGBitmapContextGetData(gridContext);
+        for (size_t i = 0; i < gridWidth * gridHeight; i++) {
+            uint8_t *pixel = pixels + i * 4;
+            uint32_t alpha = pixel[3];
+            if (alpha < 89) {
+                pixel[0] = 0;
+                pixel[1] = 0;
+                pixel[2] = 0;
+                pixel[3] = 0;
+            } else {
+                uint32_t luma = (pixel[0] * 2126 + pixel[1] * 7152 + pixel[2] * 722) / 10000;
+                uint32_t value = MIN((uint32_t)255, luma * 255 / alpha);
+                pixel[0] = (uint8_t)value;
+                pixel[1] = (uint8_t)value;
+                pixel[2] = (uint8_t)value;
+                pixel[3] = 255;
+            }
+        }
+
+        CGImageRef gridImage = CGBitmapContextCreateImage(gridContext);
+        if (gridImage != NULL) {
+            CGContextSetInterpolationQuality(fullContext, kCGInterpolationNone);
+            CGContextSetShouldAntialias(fullContext, false);
+            CGContextDrawImage(fullContext, CGRectMake(0.0, 0.0, (CGFloat)fullWidth, (CGFloat)fullHeight), gridImage);
+            CGImageRef fullImage = CGBitmapContextCreateImage(fullContext);
+            if (fullImage != NULL) {
+                result = [[UIImage imageWithCGImage:fullImage scale:image.scale orientation:image.imageOrientation] imageWithRenderingMode:image.renderingMode];
+                CGImageRelease(fullImage);
+            }
+            CGImageRelease(gridImage);
+        }
+    }
+    if (gridContext != NULL) {
+        CGContextRelease(gridContext);
+    }
+    if (fullContext != NULL) {
+        CGContextRelease(fullContext);
+    }
+    CGColorSpaceRelease(colorSpace);
+    return result;
+}
