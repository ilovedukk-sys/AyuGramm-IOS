+    override func touchesBegan(_ touches: Set<UITouch>, with event: UIEvent) {
+        super.touchesBegan(touches, with: event)
+        if let shouldBegin = self.shouldBegin, !shouldBegin() {
+            self.state = .failed
+            return
+        }
+        guard let touch = touches.first else {
+            return
+        }
+        // A control that takes drags of its own, such as a voice message's scrubber.
+        var current = touch.view
+        while let view = current, view !== self.view {
+            if view.gestureRecognizers?.contains(where: { $0 is UIPanGestureRecognizer && !($0 is ChatSwipeToReplyRecognizer) }) == true {
+                self.state = .failed
+                return
+            }
+            current = view.superview
+        }
+        self.firstLocation = touch.location(in: nil)
+    }
