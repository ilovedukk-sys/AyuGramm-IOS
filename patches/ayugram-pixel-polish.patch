+    // Stickers, custom emoji and Lottie animations: gray, on a grid of `cell` points.
+    public static func applyMediaStyle(to layer: CALayer, cell: CGFloat = 1.0) {
+        guard self.isEnabled else {
+            return
+        }
+        if layer.filters == nil, let filter = makeGrayscaleFilter() {
+            layer.filters = [filter]
+        }
+        layer.magnificationFilter = .nearest
+        layer.rasterizationScale = 1.0 / cell
+        layer.shouldRasterize = true
+    }
+
+    public static func mediaCell(size: CGSize) -> CGFloat {
+        return max(size.width, size.height) >= 100.0 ? 2.0 : 1.0
+    }
+
+    public static func steppedFraction(_ value: CGFloat, steps: CGFloat = 5.0) -> CGFloat {
+        guard self.isEnabled else {
+            return value
+        }
+        return ceil(value * steps) / steps
+    }
+
+    // Capitals in every attribute run, so that fonts and custom emoji stay in place.
+    public static func uppercased(_ string: NSAttributedString) -> NSAttributedString {
+        guard self.isEnabled else {
+            return string
+        }
+        let result = NSMutableAttributedString(attributedString: string)
+        let text = string.string as NSString
+        string.enumerateAttributes(in: NSRange(location: 0, length: string.length), options: .reverse, using: { attributes, range, _ in
+            result.replaceCharacters(in: range, with: NSAttributedString(string: text.substring(with: range).uppercased(), attributes: attributes))
+        })
+        return result
+    }
