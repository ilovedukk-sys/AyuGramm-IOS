new file mode 100644
index 0000000..349bb63
--- /dev/null
+++ b/submodules/Display/Source/AyuMessagesStyle.swift
@@ -0,0 +1,24 @@
+import Foundation
+
+/// The look of Apple's Messages app, on by default. Read once per launch, because colours,
+/// bubble images and row layouts are cached; Appearance+ offers the switch.
+public enum AyuMessagesStyle {
+    private static let key = "ayu.appearance.messagesStyle"
+
+    public static var setting: Bool {
+        get {
+            return UserDefaults.standard.object(forKey: key) as? Bool ?? true
+        }
+        set {
+            _ = AyuMessagesStyle.isEnabled
+            UserDefaults.standard.set(newValue, forKey: key)
+            NotificationCenter.default.post(name: AyuAppearancePlus.didChangeNotification, object: nil)
+        }
+    }
+
+    public static let isEnabled: Bool = AyuMessagesStyle.setting
+
+    public static var needsRelaunch: Bool {
+        return AyuMessagesStyle.setting != AyuMessagesStyle.isEnabled
+    }
+}
