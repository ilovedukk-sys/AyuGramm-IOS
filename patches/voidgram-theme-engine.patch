+import Foundation
+import UIKit
+import UniformTypeIdentifiers
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+// Settings → VoidGram → Themes, colours & badges → VoidGram themes: .vgtheme files.
+// Pick, import (Files, clipboard, a file in a chat), share, delete, and make new ones from
+// the Customization colours or from every key of the current Telegram theme.
+
+private func ayuThemeEngineSignal() -> Signal<Void, NoError> {
+    return Signal { subscriber in
+        subscriber.putNext(Void())
+        let observer = NotificationCenter.default.addObserver(forName: AyuThemeEngine.didChangeNotification, object: nil, queue: .main, using: { _ in
+            subscriber.putNext(Void())
+        })
+        return ActionDisposable {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+}
+
+private final class AyuThemePicker: NSObject, UIDocumentPickerDelegate {
+    static var current: AyuThemePicker?
+    private let picked: (URL) -> Void
+
+    init(picked: @escaping (URL) -> Void) {
+        self.picked = picked
+    }
+
+    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+        if let url = urls.first {
+            self.picked(url)
+        }
+        AyuThemePicker.current = nil
+    }
+
+    func documentPickerWasCancelled(_ controller: UIDocumentPickerViewController) {
+        AyuThemePicker.current = nil
+    }
+}
+
+private func ayuThemePresent(_ context: AccountContext, _ controller: UIViewController) {
+    if let popover = controller.popoverPresentationController, let view = context.sharedContext.mainWindow?.viewController?.view {
+        popover.sourceView = view
+        popover.sourceRect = CGRect(x: view.bounds.midX, y: view.bounds.midY, width: 1.0, height: 1.0)
+        popover.permittedArrowDirections = []
+    }
+    context.sharedContext.applicationBindings.presentNativeController(controller)
+}
+
+private func ayuThemeAlert(_ context: AccountContext, _ title: String, _ message: String) {
+    let alert = UIAlertController(title: title, message: message, preferredStyle: .alert)
+    alert.addAction(UIAlertAction(title: "OK", style: .default))
+    ayuThemePresent(context, alert)
+}
+
+private func ayuThemeShare(_ context: AccountContext, _ data: Data, filename: String) {
+    let url = FileManager.default.temporaryDirectory.appendingPathComponent(filename)
+    guard (try? data.write(to: url, options: .atomic)) != nil else { return }
+    ayuThemePresent(context, UIActivityViewController(activityItems: [url], applicationActivities: nil))
+}
+
+/// Shows what a theme file is and installs it on confirmation; used by the Themes page and when a
+/// .vgtheme file is opened in a chat.
+public func ayuImportTheme(context: AccountContext, data: Data) {
+    let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+    let russian = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+    let checked: (AyuThemeEngine.Theme, [String])
+    do {
+        checked = try AyuThemeEngine.check(data, knownKey: ayuThemeEngineKeyChecker(presentationData.theme))
+    } catch {
+        ayuThemeAlert(context, russian ? "Тема не подходит" : "Theme not accepted", "\(error)")
+        return
+    }
+    let (theme, warnings) = checked
+    let replaces = AyuThemeEngine.installed.contains(where: { $0.id == theme.id && !$0.isBuiltin })
+    var lines: [String] = []
+    if !theme.author.isEmpty {
+        lines.append((russian ? "Автор: " : "Author: ") + theme.author)
+    }
+    if !theme.summary.isEmpty {
+        lines.append(theme.summary)
+    }
+    if replaces {
+        lines.append(russian ? "Заменит установленную тему с тем же id «\(theme.id)»." : "Replaces the installed theme with the id “\(theme.id)”.")
+    }
+    if !warnings.isEmpty {
+        lines.append((russian ? "Предупреждения:\n" : "Warnings:\n") + warnings.prefix(5).joined(separator: "\n"))
+    }
+    let alert = UIAlertController(title: theme.name(russian: russian), message: lines.joined(separator: "\n\n"), preferredStyle: .alert)
+    func install(apply: Bool) {
+        do {
+            let installed = try AyuThemeEngine.install(data)
+            if apply {
+                AyuThemeEngine.activate(installed.id)
+            }
+        } catch {
+            ayuThemeAlert(context, russian ? "Не удалось установить" : "Could not install", "\(error)")
+        }
+    }
+    alert.addAction(UIAlertAction(title: russian ? "Установить и применить" : "Install and apply", style: .default, handler: { _ in install(apply: true) }))
+    alert.addAction(UIAlertAction(title: russian ? "Только установить" : "Install only", style: .default, handler: { _ in install(apply: false) }))
+    alert.addAction(UIAlertAction(title: russian ? "Отмена" : "Cancel", style: .cancel))
+    ayuThemePresent(context, alert)
+}
+
+public func ayuImportTheme(context: AccountContext, fileURL: URL) {
+    let access = fileURL.startAccessingSecurityScopedResource()
+    defer {
+        if access { fileURL.stopAccessingSecurityScopedResource() }
+    }
+    guard let data = try? Data(contentsOf: fileURL) else {
+        let russian = context.sharedContext.currentPresentationData.with { $0 }.strings.baseLanguageCode.hasPrefix("ru")
+        ayuThemeAlert(context, "VoidGram", russian ? "Не удалось прочитать файл." : "Could not read the file.")
+        return
+    }
+    ayuImportTheme(context: context, data: data)
+}
