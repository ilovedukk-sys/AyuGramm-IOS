+        guard image.size.width >= 16.0, image.size.height >= 16.0, let cgImage = image.cgImage else {
+            return image
+        }
+        let cells = 24
+        let colorSpace = CGColorSpaceCreateDeviceGray()
+        guard let context = CGContext(data: nil, width: cells, height: cells, bitsPerComponent: 8, bytesPerRow: 0, space: colorSpace, bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue) else {
