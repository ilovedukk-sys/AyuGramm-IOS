{
  "vgtheme": 1,
  "id": "dracula",
  "name": "Dracula",
  "author": "VoidGram",
  "description": "The dark theme from draculatheme.com.",
  "base": "night",
  "accent": "$purple",
  "vars": {
    "bg": "#282A36",
    "current": "#44475A",
    "fg": "#F8F8F2",
    "comment": "#6272A4",
    "purple": "#BD93F9",
    "pink": "#FF79C6",
    "green": "#50FA7B",
    "red": "#FF5555"
  },
  "colors": {
    "background": "$bg",
    "surface": "mix($bg, $current, 0.5)",
    "separator": "$current",
    "text": "$fg",
    "secondaryText": "$comment",
    "destructive": "$red",
    "switch.on": "$green",
    "tabBar.selected": "$purple",
    "badge.background": "$pink",
    "badge.text": "$bg",
    "chatList.title": "$fg",
    "chatList.online": "$green",
    "chatList.checkmark": "$green",
    "outgoing.bubble": "$comment",
    "outgoing.text": "$fg",
    "outgoing.secondaryText": "alpha($fg, 0.65)",
    "outgoing.link": "$pink",
    "outgoing.accent": "$pink",
    "outgoing.check": "$green",
    "incoming.bubble": "$current",
    "incoming.text": "$fg",
    "incoming.secondaryText": "lighten($comment, 0.25)",
    "incoming.link": "$purple",
    "incoming.accent": "$pink",
    "input.field": "$current",
    "input.accent": "$purple",
    "input.sendIcon": "$bg"
  },
  "wallpaper": "#282A36"
}
