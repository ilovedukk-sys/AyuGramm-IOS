+
+/// The entries are in ascending order here.
+private func ayuMarkLastOutgoing(_ entries: inout [ChatHistoryEntry]) {
+    for index in entries.indices.reversed() {
+        switch entries[index] {
+        case let .MessageEntry(message, presentationData, read, location, selection, attributes):
+            if ayuIsCaptionedOutgoing(message) {
+                var attributes = attributes
+                attributes.ayuIsLastOutgoing = true
+                entries[index] = .MessageEntry(message, presentationData, read, location, selection, attributes)
+                return
+            }
+        case let .MessageGroupEntry(groupId, messages, presentationData):
+            if let last = messages.last, ayuIsCaptionedOutgoing(last.0) {
+                entries[index] = .MessageGroupEntry(groupId, messages.map { value in
+                    var attributes = value.3
+                    attributes.ayuIsLastOutgoing = true
+                    return (value.0, value.1, value.2, attributes, value.4)
+                }, presentationData)
+                return
+            }
+        default:
+            break
+        }
+    }
+}
